@model List<USER_QUANLYPHONGTRO.Models.ViewModels.KhachThue.TenantInvoiceViewModel>
@using System.Linq

@{
    ViewBag.Title = "Hóa Đơn Của Tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var invoiceList = Model ?? new List<USER_QUANLYPHONGTRO.Models.ViewModels.KhachThue.TenantInvoiceViewModel>();
}

@section styles {
        <style>
            .invoice-page {
                padding: 30px 0;
                background: #f5f7fa;
                min-height: 100vh;
            }

            .page-header {
                background: linear-gradient(135deg, #f6ad55 0%, #ed8936 100%);
                color: white;
                padding: 40px 30px;
                border-radius: 15px;
                margin-bottom: 30px;
            }

            .page-header h1 {
                font-size: 32px;
                font-weight: 700;
                margin-bottom: 10px;
            }

            .invoice-list {
                background: white;
                border-radius: 15px;
                padding: 30px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            }

            .invoice-item {
                border: 2px solid #e2e8f0;
                border-radius: 12px;
                padding: 25px;
                margin-bottom: 20px;
                transition: all 0.3s;
            }

            .invoice-item:hover {
                border-color: #f6ad55;
                box-shadow: 0 5px 20px rgba(246, 173, 85, 0.15);
            }

            .invoice-header {
                display: flex;
                justify-content: space-between;
                align-items: start;
                margin-bottom: 20px;
                flex-wrap: wrap;
                gap: 15px;
            }

            .invoice-info h3 {
                font-size: 22px;
                font-weight: 700;
                color: #2d3748;
                margin-bottom: 8px;
            }

            .invoice-period {
                color: #718096;
                font-size: 14px;
            }

            .invoice-amount {
                text-align: right;
            }

            .amount-label {
                color: #718096;
                font-size: 13px;
                margin-bottom: 5px;
            }

            .amount-value {
                font-size: 32px;
                font-weight: 800;
                background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .invoice-details {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                gap: 15px;
                padding: 20px;
                background: #f7fafc;
                border-radius: 8px;
                margin-top: 15px;
            }

            .detail-row {
                display: flex;
                justify-content: space-between;
                padding: 10px 0;
                border-bottom: 1px solid #e2e8f0;
            }

            .detail-row:last-child {
                border-bottom: none;
                font-weight: 700;
                font-size: 16px;
            }

            .detail-label {
                color: #718096;
            }

            .detail-value {
                color: #2d3748;
                font-weight: 600;
            }

            .badge {
                padding: 8px 16px;
                border-radius: 20px;
                font-size: 13px;
                font-weight: 700;
            }

            .badge-success {
                background: rgba(72, 187, 120, 0.15);
                color: #48bb78;
            }

            .badge-danger {
                background: rgba(252, 129, 129, 0.15);
                color: #fc8181;
            }

            .badge-warning {
                background: rgba(246, 173, 85, 0.15);
                color: #f6ad55;
            }

            .btn-pay {
                background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
                color: white;
                padding: 10px 25px;
                border-radius: 8px;
                text-decoration: none;
                font-weight: 600;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: all 0.3s;
                border: none;
                cursor: pointer;
            }

            .btn-pay:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(72, 187, 120, 0.3);
                text-decoration: none;
                color: white;
            }

            .btn-download {
                background: white;
                color: #667eea;
                border: 2px solid #667eea;
                padding: 10px 25px;
                border-radius: 8px;
                text-decoration: none;
                font-weight: 600;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: all 0.3s;
                cursor: pointer;
            }

            .btn-download:hover {
                background: #667eea;
                color: white;
                text-decoration: none;
            }

            .invoice-actions {
                display: flex;
                gap: 10px;
                margin-top: 20px;
                flex-wrap: wrap;
            }

            .empty-state {
                text-align: center;
                padding: 80px 20px;
            }

            .empty-state i {
                font-size: 80px;
                color: #e2e8f0;
                margin-bottom: 20px;
            }

            .empty-state h3 {
                color: #718096;
                margin-bottom: 15px;
            }

            .summary-cards {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                gap: 20px;
                margin-bottom: 30px;
            }

            .summary-card {
                background: white;
                padding: 25px;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.08);
                border-left: 5px solid var(--color);
            }

            .summary-card.paid {
                --color: #48bb78;
            }

            .summary-card.unpaid {
                --color: #fc8181;
            }

            .summary-card.total {
                --color: #667eea;
            }

            .summary-label {
                color: #718096;
                font-size: 13px;
                margin-bottom: 10px;
            }

            .summary-value {
                font-size: 28px;
                font-weight: 800;
                color: #2d3748;
            }
        </style>
}

<div class="invoice-page">
    <div class="container">
        <div class="page-header">
            <h1><i class="fa fa-receipt"></i> Hóa Đơn Của Tôi</h1>
            <p>Quản lý và thanh toán hóa đơn tiền thuê, điện, nước</p>
        </div>

        <!-- Summary Cards -->
        <div class="summary-cards">
            <div class="summary-card total">
                <div class="summary-label">Tổng Hóa Đơn</div>
                <div class="summary-value">@invoiceList.Count</div>
            </div>
            <div class="summary-card paid">
                <div class="summary-label">Đã Thanh Toán</div>
                <div class="summary-value">@invoiceList.Count(x => x.TrangThai == "Đã thanh toán")</div>
            </div>
            <div class="summary-card unpaid">
                <div class="summary-label">Chưa Thanh Toán</div>
                <div class="summary-value">@invoiceList.Count(x => x.TrangThai == "Chưa thanh toán")</div>
            </div>
        </div>

        <div class="invoice-list">
            @if (invoiceList.Any())
            {
                foreach (var item in invoiceList)
                {
                            <div class="invoice-item">
                                <div class="invoice-header">
                                    <div class="invoice-info">
                                        <h3>Hóa Đơn Tháng @item.ThangNam</h3>
                                        <div class="invoice-period">
                                            <i class="fa fa-calendar"></i>
                                            Kỳ thanh toán: @item.ThangNam
                                        </div>
                                    </div>
                                    <div class="invoice-amount">
                                        <div class="amount-label">Tổng tiền</div>
                                        <div class="amount-value">@item.TongTien.ToString("N0")đ</div>
                                    </div>
                                </div>

                                <div class="invoice-details">
                                    <div class="detail-row">
                                        <span class="detail-label">Tiền thuê:</span>
                                        <span class="detail-value">@item.TienThue.ToString("N0")đ</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">Tiền điện:</span>
                                        <span class="detail-value">@item.TienDien.ToString("N0")đ</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">Tiền nước:</span>
                                        <span class="detail-value">@item.TienNuoc.ToString("N0")đ</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">Phí khác:</span>
                                        <span class="detail-value">@item.PhiKhac.ToString("N0")đ</span>
                                    </div>
                                </div>

                                <div class="invoice-actions">
                                    <span class="badge badge-@(item.TrangThai == "Đã thanh toán" ? "success" : "danger")">
                                        <i class="fa fa-@(item.TrangThai == "Đã thanh toán" ? "check-circle" : "exclamation-circle")"></i>
                                @item.TrangThai
                                    </span>

                            @if (item.TrangThai != "Đã thanh toán")
                            {
                                            <button class="btn-pay" onclick="showPaymentQR('@item.TongTien', '@item.ThangNam')">
                                                <i class="fa fa-credit-card"></i> Thanh Toán Ngay
                                            </button>
                            }

                                    <button class="btn-download">
                                        <i class="fa fa-download"></i> Tải Hóa Đơn
                                    </button>
                                </div>
                            </div>
                }
            }
            else
            {
                    <div class="empty-state">
                        <i class="fa fa-receipt"></i>
                        <h3>Chưa có hóa đơn nào</h3>
                        <p>Các hóa đơn sẽ được tạo tự động vào đầu mỗi tháng</p>
                    </div>
            }
        </div>
    </div>
</div>

<!-- Payment QR Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="background: none; border: none; font-size: 24px; color: #a0aec0;">
                    <i class="fa fa-times"></i>
                </button>
            </div>
            <div class="modal-body text-center p-4 pt-0">
                <div class="mb-4">
                    <img id="qrImage" src="" alt="QR Payment" class="img-fluid rounded-3 shadow-sm border" style="max-width: 300px;">
                </div>
                <h4 class="fw-bold mb-2">Quét mã QR để thanh toán</h4>
                <p class="text-muted mb-4">Số tiền: <span id="qrAmount" class="text-danger fw-bold"></span></p>

                <div class="bg-light p-3 rounded-3 text-start mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Ngân hàng:</span>
                        <span class="fw-bold small">MB Bank</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Chủ tài khoản:</span>
                        <span class="fw-bold small">PHAM LE THIEU QUANG</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted small">Nội dung:</span>
                        <span id="qrInfo" class="fw-bold small text-primary"></span>
                    </div>
                </div>

                <div class="alert alert-info py-2 px-3 small border-0 text-start">
                    <i class="fa fa-info-circle me-2"></i>
                    Sau khi chuyển khoản thành công, hệ thống sẽ tự động cập nhật trạng thái trong vòng 5-10 phút.
                </div>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-secondary w-100 rounded-pill fw-bold" data-bs-dismiss="modal">Đã hiểu</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        let paymentCheckInterval;

        function showPaymentQR(amount, period) {
            // Chuẩn bị link VietQR
            const cleanAmount = amount.replace(/[^0-9]/g, '');
            // period có định dạng "MM/YYYY", ví dụ "01/2025" -> Lấy "01" rồi bỏ số 0 ở đầu thành "1"
            const month = period.split('/')[0].replace(/^0+/, '');
            const info = "TIEN TRO T" + month;
            const qrUrl = `https://img.vietqr.io/image/mb-0842192393-compact2.png?amount=${cleanAmount}&addinfo=${encodeURIComponent(info)}&accountName=PHAM%20LE%20THIEU%20QUANG`;
            
            // Cập nhật giao diện modal
            document.getElementById('qrImage').src = qrUrl;
            document.getElementById('qrAmount').innerText = parseInt(cleanAmount).toLocaleString('vi-VN') + ' đ';
            document.getElementById('qrInfo').innerText = info;
            
            // Hiển thị modal
            const myModal = new bootstrap.Modal(document.getElementById('paymentModal'));
            myModal.show();

            // GIẢ LẬP: Tự động kiểm tra thanh toán sau 10 giây
            startSimulatedPaymentCheck();
        }

        function startSimulatedPaymentCheck() {
            // Xóa interval cũ nếu có
            if (paymentCheckInterval) clearInterval(paymentCheckInterval);

            // Hiển thị trạng thái đang kiểm tra
            const alertBox = document.querySelector('.alert-info');
            alertBox.innerHTML = '<i class="fa fa-spinner fa-spin me-2"></i> Đang chờ hệ thống xác nhận thanh toán...';
            alertBox.className = 'alert alert-warning py-2 px-3 small border-0 text-start';

            // Giả lập sau 10 giây sẽ báo thành công
            paymentCheckInterval = setTimeout(() => {
                alertBox.innerHTML = '<i class="fa fa-check-circle me-2"></i> <strong>Thành công!</strong> Đã nhận được tiền thanh toán.';
                alertBox.className = 'alert alert-success py-2 px-3 small border-0 text-start';
                
                // Hiệu ứng pháo hoa nhẹ bằng console hoặc thông báo
                console.log("Thanh toán thành công!");
                
                // Tự động đóng modal sau 3 giây và load lại trang
                setTimeout(() => {
                    location.reload(); 
                }, 3000);

            }, 10000); 
        }

        $(document).ready(function() {
            // Khi đóng modal thì xóa timer
            $('#paymentModal').on('hidden.bs.modal', function () {
                if (paymentCheckInterval) clearTimeout(paymentCheckInterval);
            });

            $('.sidebar-toggle').on('click', function() {
                $('#sidebar').toggleClass('active');
            });
        });
    </script>
}
