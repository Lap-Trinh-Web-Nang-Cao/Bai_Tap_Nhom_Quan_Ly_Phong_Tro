@using USER_QUANLYPHONGTRO.Models.Dtos.Rooms
@model List<PhongDto>

@{
    ViewBag.Title = "Danh Sách Phòng Trọ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string keyword = ViewBag.Keyword ?? "";
    string priceRange = ViewBag.PriceRange ?? "";
    string areaRange = ViewBag.AreaRange ?? "";
}

@section styles {
    <style>
        .page-banner {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 60px 20px;
            text-align: center;
            color: white;
            margin: 0 -15px 40px;
            border-radius: 0 0 30px 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .filter-section {
            background: white;
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.05);
            margin-top: -80px;
            position: relative;
            z-index: 10;
            border: 1px solid #f0f0f0;
        }

        .form-control, .form-select {
            border-radius: 12px;
            padding: 12px 15px;
            border: 1px solid #e2e8f0;
            transition: all 0.3s;
        }

        .form-control:focus, .form-select:focus {
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            border-color: #667eea;
        }

        .btn-search {
            height: 50px;
            border-radius: 12px;
            font-weight: 700;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 0 30px;
            transition: all 0.3s;
        }

        .btn-search:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
        }

        .room-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 25px;
            margin: 40px 0;
        }

        .room-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border: 1px solid #f0f0f0;
            display: flex;
            flex-direction: column;
            text-decoration: none !important;
        }

        .room-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.1);
        }

        .room-image {
            height: 220px;
            background-size: cover;
            background-position: center;
            position: relative;
        }

        .room-badge {
            position: absolute;
            top: 15px;
            left: 15px;
            background: #48bb78;
            color: white;
            padding: 5px 12px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 800;
        }

        .room-rating {
            position: absolute;
            top: 15px;
            right: 15px;
            background: white;
            color: #f59e0b;
            padding: 4px 10px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .room-content {
            padding: 20px;
            flex-grow: 1;
        }

        .room-title {
            font-size: 17px;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 10px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.4;
        }

        .room-location {
            font-size: 13px;
            color: #718096;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .room-details {
            display: flex;
            gap: 15px;
            padding-top: 15px;
            border-top: 1px dashed #edf2f7;
            margin-top: auto;
        }

        .detail-item {
            font-size: 13px;
            color: #4a5568;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .room-price {
            font-size: 22px;
            font-weight: 800;
            color: #e53e3e;
            margin-bottom: 10px;
        }

        .room-price span {
            font-size: 13px;
            color: #a0aec0;
            font-weight: 500;
        }

        .pagination {
            justify-content: center;
            gap: 8px;
            margin-top: 40px;
        }

        .page-link {
            border-radius: 10px !important;
            border: none;
            padding: 10px 18px;
            color: #4a5568;
            font-weight: 600;
            transition: all 0.2s;
        }

        .page-item.active .page-link {
            background: #667eea;
            color: white;
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }
        
        .no-results {
            text-align: center;
            padding: 80px 20px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        }
    </style>
}

<div class="page-banner">
    <div class="container">
        <h1>🏘️ Tìm Kiếm Phòng Trọ</h1>
        <p>Hàng ngàn sự lựa chọn tốt nhất đang chờ bạn</p>
    </div>
</div>

<div class="container">
    <div class="filter-section">
        <form method="get" class="row g-3">
            <div class="col-lg-4 col-md-6">
                <label class="form-label fw-bold"><i class="fa fa-keyboard-o"></i> Từ khóa</label>
                <input type="text" name="keyword" class="form-control" placeholder="Nhập địa điểm, tên phòng..." value="@keyword" />
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label fw-bold"><i class="fa fa-money"></i> Khoảng giá</label>
                <select name="priceRange" class="form-select">
                    <option value="">Tất cả mức giá</option>
                    <option value="0-2000000" @(priceRange == "0-2000000" ? "selected" : "")>Dưới 2 triệu</option>
                    <option value="2000000-3000000" @(priceRange == "2000000-3000000" ? "selected" : "")>2 - 3 triệu</option>
                    <option value="3000000-5000000" @(priceRange == "3000000-5000000" ? "selected" : "")>3 - 5 triệu</option>
                    <option value="5000000-10000000" @(priceRange == "5000000-10000000" ? "selected" : "")>Trên 5 triệu</option>
                </select>
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label fw-bold"><i class="fa fa-expand"></i> Diện tích</label>
                <select name="areaRange" class="form-select">
                    <option value="">Tất cả diện tích</option>
                    <option value="0-20" @(areaRange == "0-20" ? "selected" : "")>Dưới 20m²</option>
                    <option value="20-30" @(areaRange == "20-30" ? "selected" : "")>20 - 30m²</option>
                    <option value="30-50" @(areaRange == "30-50" ? "selected" : "")>30 - 50m²</option>
                    <option value="50-100" @(areaRange == "50-100" ? "selected" : "")>Trên 50m²</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-6 d-flex align-items-end">
                <button type="submit" class="btn btn-primary btn-search w-100">
                    <i class="fa fa-search"></i> Tìm kiếm
                </button>
            </div>
        </form>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="room-grid">
            @foreach (var room in Model)
            {
                <a href="@Url.Action("ChiTietPhong", "KhachThue", new { id = room.PhongId })" class="room-card">
                    <div class="room-image" style="background-image: url('@Url.Content(room.HinhAnhDaiDien ?? "~/images/banner-login.png")')">
                        @if (room.IsDuyet)
                        {
                            <span class="room-badge">✓ Đã Xác Minh</span>
                        }
                        @if (room.DiemTrungBinh.HasValue && room.DiemTrungBinh > 0)
                        {
                            <div class="room-rating">
                                <i class="fa fa-star"></i> @room.DiemTrungBinh.Value.ToString("0.0")
                            </div>
                        }
                    </div>
                    <div class="room-content">
                        <div class="room-price">
                            @room.GiaTien.ToString("N0")đ <span>/tháng</span>
                        </div>
                        <h3 class="room-title">@room.TieuDe</h3>
                        <div class="room-location">
                            <i class="fa fa-map-marker"></i>
                            <span>@(room.NhaTro != null ? room.NhaTro.DiaChi : "Đang cập nhật địa chỉ...")</span>
                        </div>
                        <div class="room-details">
                            <div class="detail-item">
                                <i class="fa fa-expand-arrows-alt"></i> @(room.DienTich.HasValue ? room.DienTich.Value.ToString("N0") : "0")m²
                            </div>
                            <div class="detail-item">
                                <i class="fa fa-users"></i> Tối đa @(room.SoNguoiToiDa) người
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>

        if (totalPages > 1)
        {
            <nav>
                <ul class="pagination">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("DanhSachPhong", "KhachThue", new { page = i, keyword = keyword, priceRange = priceRange, areaRange = areaRange })">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="no-results mt-5">
            <i class="fa fa-search-minus" style="font-size: 80px; color: #cbd5e0; margin-bottom: 20px; display: block;"></i>
            <h2 style="color: #4a5568;">Không tìm thấy kết quả nào</h2>
            <p style="color: #718096;">Thử thay đổi từ khóa hoặc bộ lọc để có kết quả tốt hơn.</p>
            <a href="@Url.Action("DanhSachPhong", "KhachThue")" class="btn btn-outline-primary mt-3" style="border-radius: 12px; font-weight: 600;">
                <i class="fa fa-refresh"></i> Xóa bộ lọc
            </a>
        </div>
    }
</div>