@{
    ViewBag.Title = "Tin Nhắn - TroTot";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="alert alert-info" role="alert">
                <i class="fa fa-info-circle"></i>
                <strong>Thông báo:</strong> Chức năng tin nhắn đã chuyển sang 
                <a href="@Url.Action("PhongChat", "Chat")" class="alert-link">
                    <strong>Phòng Chat</strong>
                </a>
                . Vui lòng nhấp vào liên kết để truy cập.
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-8 offset-md-2 text-center">
            <h3>💬 Phòng Chat Realtime</h3>
            <p class="text-muted mt-3">
                Hãy truy cập vào phòng chat để trao đổi với chủ trọ và những người dùng khác.
            </p>
            <a href="@Url.Action("PhongChat", "Chat")" class="btn btn-primary btn-lg mt-4">
                <i class="fa fa-comments"></i> Vào Phòng Chat
            </a>
        </div>
    </div>
</div>
