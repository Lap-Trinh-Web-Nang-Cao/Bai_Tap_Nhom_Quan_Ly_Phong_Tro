@model IEnumerable<USER_QUANLYPHONGTRO.Models.Dtos.Rooms.PhongDto>

@if (Model != null && Model.Any())
{
    <div class="rooms-grid">
        @foreach (var room in Model)
        {
            <div class="room-card">
                <div class="room-image"
                    style="background-image: url('@Url.Content(room.HinhAnhDaiDien)'); background-size: cover; background-position: center;">
                    @if (room.IsDuyet)
                    {
                        <span class="room-badge">✓ Đã Duyệt</span>
                    }
                </div>
                <div class="room-content">
                    <h3 class="room-title">@room.TieuDe</h3>

                    @if (room.NhaTro != null)
                    {
                        <div class="room-location">
                            <i class="fa fa-map-marker-alt"></i>
                            <span>@room.NhaTro.DiaChi</span>
                        </div>
                    }

                    @if (room.DiemTrungBinh.HasValue && room.DiemTrungBinh > 0)
                    {
                        <div style="color: #ffa500; font-size: 14px; margin-bottom: 10px;">
                            @for (int i = 0; i < (int)Math.Floor(room.DiemTrungBinh.Value); i++)
                            {
                                <i class="fa fa-star"></i>
                            }
                            <span style="color: #333; font-weight: 600; margin-left: 5px;">
                                @room.DiemTrungBinh.Value.ToString("0.0")
                            </span>
                        </div>
                    }

                    <div class="room-price">
                        @room.GiaTien.ToString("N0")đ
                        <span style="font-size: 0.4em; color: #999;">/tháng</span>
                    </div>

                    <div class="room-features">
                        @if (room.DienTich.HasValue)
                        {
                            <div class="feature-item">
                                <i class="fa fa-expand-arrows-alt"></i>
                                <span>@room.DienTich m²</span>
                            </div>
                        }
                        <div class="feature-item">
                            <i class="fa fa-users"></i>
                            <span>@room.SoNguoiToiDa người</span>
                        </div>
                    </div>

                    <a href="@Url.Action("ChiTietPhong", "Guest", new { id = room.PhongId })" class="view-btn">
                        <i class="fa fa-eye"></i> Xem Chi Tiết
                    </a>
                </div>
            </div>
        }
    </div>

    <div class="view-all-container">
        <a href="@Url.Action("DanhSachPhong", "Guest")" class="view-all-btn">
            Xem Tất Cả @(ViewBag.TotalRooms > 0 ? ViewBag.TotalRooms.ToString() : "") Phòng <i class="fa fa-arrow-right"></i>
        </a>
    </div>
}
else
{
    <div class="no-rooms">
        <p>Đang cập nhật thêm phòng trọ...</p>
        @if (ViewBag.ErrorMessage != null)
        {
            <div style="background: #fff5f5; border: 1px solid #feb2b2; padding: 15px; border-radius: 8px; margin-top: 20px; color: #c53030; text-align: left; max-width: 600px; margin-left: auto; margin-right: auto;">
                <strong style="display: block; margin-bottom: 5px;"><i class="fa fa-exclamation-triangle"></i> Debug Info:</strong>
                <p style="font-family: monospace; font-size: 13px; margin: 0;">@ViewBag.ErrorMessage</p>
            </div>
        }
        @if (ViewBag.ApiSuccess == false)
        {
            <p style="color: orange; margin-top: 10px; font-weight: 600;">API call không thành công. Vui lòng kiểm tra Backend.</p>
        }
    </div>
}
