@model USER_QUANLYPHONGTRO.Models.ViewModels.ChuTro.LandlordDashboardViewModel

@{
    Layout = "~/Views/Shared/_ChutroLayout.cshtml";
    ViewBag.Title = "Tổng quan";
}

@* Chỉ bắt đầu từ dashboard-container vì layout đã lo phần wrapper bên ngoài *@
<div class="dashboard-container">

    <div class="dashboard-header">
        <div>
            <h1 class="page-title">Chào buổi sáng, @(Session["UserName"] ?? "Chủ Trọ")!</h1>
            <p class="page-subtitle">Đây là những gì đang diễn ra với các phòng trọ của bạn hôm nay.</p>
        </div>
        <select id="timeFilter" class="time-filter">
            <option value="30days">30 ngày qua</option>
            <option value="7days">7 ngày qua</option>
            <option value="today">Hôm nay</option>
        </select>
    </div>

    <div class="stats-grid">
        <div class="stat-card card-blue">
            <div class="stat-label">TỔNG SỐ PHÒNG</div>
            <div class="stat-value">@Model.TongSoPhong</div> @* Đã sửa sang tiếng Việt *@
            <div class="stat-desc">Số lượng phòng bạn đang quản lý</div>
        </div>
        <div class="stat-card card-orange">
            <div class="stat-label">LƯỢT XEM HÔM NAY</div>
            <div class="stat-value">@Model.LuotXemHomNay</div> @* Đã sửa sang tiếng Việt *@
            <div class="stat-desc">Tổng lượt xem các phòng của bạn</div>
        </div>
        <div class="stat-card card-purple">
            <div class="stat-label">LỊCH HẸN SẮP TỚI</div>
            <div class="stat-value">@Model.LichHenSapToi</div> @* Đã sửa sang tiếng Việt *@
            <div class="stat-desc">Các lịch hẹn xem phòng chưa diễn ra</div>
        </div>
        <div class="stat-card card-green">
            <div class="stat-label">DOANH THU THÁNG NÀY</div>
            <div class="stat-value">@Model.DoanhThuThang.ToString("N0")đ</div> @* Đã sửa sang tiếng Việt *@
            <div class="stat-desc">Tổng doanh thu dự kiến</div>
        </div>
    </div>

    <div class="charts-section">
        <div class="chart-card">
            <div class="chart-header">
                <h3 class="chart-title">Báo cáo doanh thu</h3>
                <div class="chart-filter">
                    <button class="filter-btn active" data-filter="30days">Tháng</button>
                    <button class="filter-btn" data-filter="7days">Tuần</button>
                </div>
            </div>
            <div class="chart-body">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
        <div class="chart-card">
            <div class="chart-header">
                <h3 class="chart-title">Lượt xem theo phòng</h3>
            </div>
            <div class="chart-body">
                <canvas id="viewsChart"></canvas>
            </div>
        </div>
    </div>

    <div class="activities-section">
        <div class="activities-row">
            <div class="activity-card">
                <div class="activity-header">
                    <h3 class="activity-title">Phòng chờ duyệt</h3>
                </div>
                <div class="activity-list">
                    @if (Model.DanhSachPhongCho != null)
                    {
                        foreach (var room in Model.DanhSachPhongCho)
                        {
                            <div class="activity-item">
                                <div class="item-image">
                                    <img src="@Url.Content(!string.IsNullOrEmpty(room.HinhAnh) ? room.HinhAnh : "~/images/logo.png")">
                                </div>
                                <div class="item-content">
                                    <div class="item-name">@room.TenPhong</div>
                                    <div class="item-info">@room.NgayDang.ToString("dd/MM/yyyy")</div>
                                </div>
                                <button class="btn-action">Xem</button>
                            </div>
                        }
                    }
                </div>
                <button class="btn-view-all">Xem tất cả</button>
            </div>

            <div class="activity-card">
                <div class="activity-header">
                    <h3 class="activity-title">Lịch xem phòng</h3>
                </div>
                <div class="activity-list">
                    @if (Model.LichHenHomNay != null)
                    {
                        foreach (var schedule in Model.LichHenHomNay)
                        {
                            <div class="activity-item">
                                <div class="item-avatar"><span class="material-icons-round">person</span></div>
                                <div class="item-content">
                                    <div class="item-name">@schedule.TenKhach</div>
                                    <div class="item-info">@schedule.TenPhong - @schedule.ThoiGianXem</div>
                                </div>
                                <span class="status-badge @(schedule.TrangThai == "Chờ xác nhận" ? "status-pending" : "status-confirmed")">@schedule.TrangThai</span>
                            </div>
                        }
                    }
                </div>
                <button class="btn-view-all">Quản lý lịch hẹn</button>
            </div>
        </div>

        <div class="activities-row" style="margin-top: 20px;">
            <div class="activity-card">
                <div class="activity-header">
                    <h3 class="activity-title">Tin nhắn mới</h3>
                </div>
                <div class="activity-list">
                    @if (Model.TinNhanGanDay != null)
                    {
                        foreach (var msg in Model.TinNhanGanDay)
                        {
                            <div class="activity-item">
                                <div class="item-avatar"><img src="@Url.Content(msg.AnhDaiDien ?? "~/images/logo.png")"></div>
                                <div class="item-content">
                                    <div class="item-name">@msg.TenNguoiGui</div>
                                    <div class="item-message">@msg.NoiDung</div>
                                </div>
                                <div class="item-time">@msg.ThoiGian</div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="activity-card">
                <div class="activity-header">
                    <h3 class="activity-title">Yêu cầu sửa chữa</h3>
                </div>
                <div class="activity-list">
                    @if (Model.YeuCauSuaChua != null)
                    {
                        foreach (var req in Model.YeuCauSuaChua)
                        {
                            <div class="activity-item">
                                <div class="item-avatar"><span class="material-icons-round">build</span></div>
                                <div class="item-content">
                                    <div class="item-name">@req.TieuDe</div>
                                    <div class="item-info">@req.TenPhong - @req.NguoiBaoCao</div>
                                </div>
                                <span class="status-badge @(req.MucDoUuTien == "Cao" ? "priority-high" : "status-pending")">@req.MucDoUuTien</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>