@model List<USER_QUANLYPHONGTRO.Models.ViewModels.ChuTro.YeuCauHoTroViewModel>

@{
    ViewBag.Title = "Yêu cầu hỗ trợ";
    Layout = "~/Views/Shared/_ChutroLayout.cshtml";
}

<div class="container-fluid mb-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-tools text-primary mr-2"></i>Yêu cầu hỗ trợ
        </h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Danh sách yêu cầu</h6>
            <div>
                <span class="badge badge-warning mr-1">Chờ xử lý</span>
                <span class="badge badge-info mr-1">Đang xử lý</span>
                <span class="badge badge-success">Hoàn thành</span>
            </div>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="thead-light">
                            <tr>
                                <th>Ngày tạo</th>
                                <th>Phòng</th>
                                <th>Người yêu cầu</th>
                                <th>Loại</th>
                                <th>Tiêu đề</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var badgeClass = "badge-warning";
                                if (item.TrangThai == "DangXuLy")
                                {
                                    badgeClass = "badge-info";
                                }
                                else if (item.TrangThai == "HoanThanh")
                                {
                                    badgeClass = "badge-success";
                                }
                                else if (item.TrangThai == "TuChoi")
                                {
                                    badgeClass = "badge-danger";
                                }
                                
                                <tr>
                                    <td>@item.ThoiGianTao.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@item.TenPhong</td>
                                    <td>@item.TenNguoiYeuCau</td>
                                    <td><span class="badge badge-secondary">@item.TenLoaiHoTro</span></td>
                                    <td>@item.TieuDe</td>
                                    <td><span class="badge @badgeClass">@item.TrangThai</span></td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary" 
                                                onclick="viewDetail('@item.HoTroId')" title="Xem chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        @if (item.TrangThai == "ChoXuLy")
                                        {
                                            <button class="btn btn-sm btn-outline-success" 
                                                    onclick="acceptRequest('@item.HoTroId')" title="Xác nhận xử lý">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" width="100" class="mb-3 opacity-50" />
                    <h5 class="text-muted">Không có yêu cầu hỗ trợ nào</h5>
                    <p class="text-muted">Các yêu cầu sửa chữa, bảo trì từ khách thuê sẽ xuất hiện ở đây.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Chi tiết -->
<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chi tiết yêu cầu</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body" id="modalContent">
                <!-- Content loaded via AJAX -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewDetail(id) {
            // TODO: Load detail via AJAX
            $('#detailModal').modal('show');
        }

        function acceptRequest(id) {
            if (confirm('Xác nhận bắt đầu xử lý yêu cầu này?')) {
                window.location.href = '@Url.Action("XuLyYeuCau", "ChuTro")/' + id;
            }
        }
    </script>
}
