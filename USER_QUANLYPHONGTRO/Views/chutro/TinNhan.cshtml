@model USER_QUANLYPHONGTRO.Models.ViewModels.ChuTro.ChatViewModel
@{
    Layout = "~/Views/Shared/_ChutroLayout.cshtml";
    ViewBag.Title = "Tin nhắn";
}

<div class="dashboard-container" style="height: calc(100vh - 120px); padding-bottom: 0;">
    <div class="chat-wrapper" style="display: flex; background: white; border-radius: 12px; height: 100%; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.05);">

        <div class="chat-sidebar" style="width: 350px; border-right: 1px solid var(--gray-100); display: flex; flex-direction: column;">
            <div style="padding: 20px; border-bottom: 1px solid var(--gray-100);">
                <h2 style="font-size: 1.25rem; font-weight: 700;">Tin nhắn</h2>
                <div class="navbar-search" style="margin-top: 15px; width: 100%;">
                    <span class="material-icons-round">search</span>
                    <input type="text" placeholder="Tìm người dùng..." style="width: 100%;">
                </div>
            </div>

            <div class="conversation-list" style="flex: 1; overflow-y: auto;">
                @foreach (var conv in Model.Conversations)
                {
                    <div class="conv-item @(conv.IsActive ? "active" : "")" style="padding: 15px 20px; cursor: pointer; display: flex; align-items: center; gap: 15px; border-bottom: 1px solid var(--gray-50); transition: 0.2s;">
                        <div class="user-avatar" style="width: 48px; height: 48px; position: relative;">
                            <img src="@Url.Content("~/images/default-avatar.png")" style="width: 100%; border-radius: 50%;">
                            @if (conv.UnreadCount > 0)
                            {
                                <span style="position: absolute; top: -2px; right: -2px; background: var(--danger); color: white; font-size: 10px; padding: 2px 6px; border-radius: 10px; border: 2px solid white;">@conv.UnreadCount</span>
                            }
                        </div>
                        <div style="flex: 1; overflow: hidden;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <strong style="font-size: 0.95rem;">@conv.UserName</strong>
                                <span style="font-size: 0.75rem; color: var(--gray-500);">@conv.Time.ToString("HH:mm")</span>
                            </div>
                            <p style="font-size: 0.85rem; color: var(--gray-600); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 4px;">@conv.LastMessage</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="chat-main" style="flex: 1; display: flex; flex-direction: column; background: #f8fafc;">
            <div class="chat-header" style="padding: 15px 25px; background: white; border-bottom: 1px solid var(--gray-100); display: flex; align-items: center; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <strong style="font-size: 1.05rem;">@Model.SelectedUserName</strong>
                    <span style="width: 8px; height: 8px; background: #10b981; border-radius: 50%;"></span>
                </div>
                <div style="display: flex; gap: 10px;">
                    <button class="navbar-icon"><span class="material-icons-round">videocam</span></button>
                    <button class="navbar-icon"><span class="material-icons-round">info</span></button>
                </div>
            </div>

            <div class="chat-messages" style="flex: 1; padding: 25px; overflow-y: auto; display: flex; flex-direction: column; gap: 15px;">
                @foreach (var msg in Model.CurrentMessages)
                {
                    <div class="message-bubble" style="max-width: 70%; padding: 12px 16px; border-radius: 16px; font-size: 0.95rem; line-height: 1.5; @(msg.IsFromMe ? "align-self: flex-end; background: var(--primary); color: white; border-bottom-right-radius: 4px;" : "align-self: flex-start; background: white; color: var(--gray-800); border-bottom-left-radius: 4px; box-shadow: 0 2px 5px rgba(0,0,0,0.02);")">
                        @msg.Content
                        <div style="font-size: 0.7rem; margin-top: 5px; opacity: 0.8; text-align: right;">@msg.Time.ToString("HH:mm")</div>
                    </div>
                }
            </div>

            <div class="chat-input" style="padding: 20px; background: white; border-top: 1px solid var(--gray-100);">
                <div style="display: flex; align-items: center; gap: 12px; background: #f1f5f9; padding: 8px 15px; border-radius: 25px;">
                    <button style="background: none; border: none; color: var(--gray-500); cursor: pointer;"><span class="material-icons-round">add_circle</span></button>
                    <input type="text" placeholder="Nhập tin nhắn..." style="flex: 1; background: none; border: none; outline: none; padding: 8px 0; font-size: 0.95rem;">
                    <button style="background: var(--primary); color: white; border: none; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer;">
                        <span class="material-icons-round" style="font-size: 20px;">send</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .conv-item:hover {
        background: #f1f5f9;
    }

    .conv-item.active {
        background: #eff6ff;
        border-right: 3px solid var(--primary);
    }
</style>