@model USER_QUANLYPHONGTRO.Models.ViewModels.ChuTro.QuanLyPhongViewModel

@{
    Layout = "~/Views/Shared/_ChutroLayout.cshtml";
    ViewBag.Title = "Quản lý phòng";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div>
            <h1 class="page-title">Hệ thống quản lý phòng</h1>
            <p class="page-subtitle">Xem danh sách, cập nhật trạng thái và quản lý tin đăng.</p>
        </div>
        @* Nút dẫn đến trang tạo mới *@
        <a href="@Url.Action("TaoPhong", "ChuTro")" class="btn-action" style="padding: 12px 24px; text-decoration: none; display: flex; align-items: center; gap: 8px;">
            <span class="material-icons-round">add</span> Thêm phòng mới
        </a>
    </div>

    <div class="activities-section">
        <div class="activity-card" style="margin-bottom: 25px; border-left: 5px solid var(--warning);">
            <div class="activity-header">
                <h3 class="activity-title">Tin đăng chờ phê duyệt (@(Model.DanhSachPhongChoDuyet?.Count ?? 0))</h3>
            </div>
            <div class="activity-list">
                @if (Model.DanhSachPhongChoDuyet != null && Model.DanhSachPhongChoDuyet.Any())
                {
                    foreach (var item in Model.DanhSachPhongChoDuyet)
                    {
                        <div class="activity-item">
                            <div class="item-image">
                                <img src="@Url.Content(!string.IsNullOrEmpty(item.HinhAnh) ? item.HinhAnh : "~/Content/images/logo.png")">
                            </div>
                            <div class="item-content">
                                <div class="item-name">@item.TenPhong</div>
                                <div class="item-info">Ngày gửi: @item.NgayDang.ToString("dd/MM/yyyy")</div>
                            </div>
                            <span class="status-badge status-pending">Đang đợi duyệt</span>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state"><p>Không có tin đăng nào đang chờ duyệt.</p></div>
                }
            </div>
        </div>

        <div class="activity-card">
            <div class="activity-header">
                <h3 class="activity-title">Danh sách phòng đang hoạt động</h3>
            </div>
            <div class="activity-list" style="max-height: none;">
                @if (Model.DanhSachTatCaPhong != null && Model.DanhSachTatCaPhong.Any())
                {
                    foreach (var p in Model.DanhSachTatCaPhong)
                    {
                        <div class="activity-item" style="padding: 15px;">
                            <div class="item-image" style="width: 70px; height: 70px;">
                                <img src="@Url.Content(!string.IsNullOrEmpty(p.HinhAnh) ? p.HinhAnh : "~/Content/images/logo.png")">
                            </div>
                            <div class="item-content">
                                <div class="item-name" style="font-size: 16px;">@p.TieuDe</div>
                                <div class="item-info">Giá: <strong style="color: var(--primary);">@p.GiaTien.ToString("N0")đ</strong></div>
                                <div class="item-info"><span class="material-icons-round" style="font-size: 14px;">location_on</span> @p.DiaChi</div>
                            </div>
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <span class="status-badge @(p.TrangThai == "Đã thuê" ? "status-confirmed" : "status-pending")">@p.TrangThai</span>
                                <a href="@Url.Action("SuaPhong", "ChuTro", new { id = p.PhongId })" class="btn-action" style="background: var(--gray-100); color: var(--gray-700);"><span class="material-icons-round">edit</span></a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>