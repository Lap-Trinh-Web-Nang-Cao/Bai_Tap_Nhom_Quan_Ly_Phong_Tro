@model List<USER_QUANLYPHONGTRO.Models.ViewModels.ChuTro.QuanLyPhongViewModel>

@{
    ViewBag.Title = "Quản Lý Phòng Trọ";
    Layout = "~/Views/Shared/_ChutroLayout.cshtml";
}

<div class="container-fluid mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 text-gray-800 font-weight-bold">
            <i class="fas fa-door-open text-primary mr-2"></i>Danh Sách Phòng
        </h2>
        <a href="@Url.Action("TaoPhong", "ChuTro")" class="btn btn-primary shadow-sm">
            <i class="fas fa-plus-circle mr-1"></i> Thêm Phòng Mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (ViewBag.Error != null || TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle mr-2"></i>@(ViewBag.Error ?? TempData["ErrorMessage"])
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-white">
            <h6 class="m-0 font-weight-bold text-primary">
                Tổng: @(Model != null ? Model.Count : 0) phòng
            </h6>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" width="100%" cellspacing="0">
                        <thead class="thead-light">
                            <tr>
                                <th width="10%">Ảnh</th>
                                <th width="30%">Thông Tin Phòng</th>
                                <th width="15%">Giá / Diện tích</th>
                                <th width="15%">Khu Trọ</th>
                                <th width="15%">Trạng Thái</th>
                                <th width="15%" class="text-center">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var imgUrl = !string.IsNullOrEmpty(item.HinhAnhDaiDien) ? item.HinhAnhDaiDien : "/images/default-room.png";
                                var shortId = item.PhongId.ToString().Substring(0, 8);
                                
                                <tr>
                                    <td>
                                        <div class="rounded overflow-hidden border" style="width: 80px; height: 60px;">
                                            <img src="@imgUrl" alt="Room" style="width: 100%; height: 100%; object-fit: cover;" 
                                                 onerror="this.src='/images/default-room.png'">
                                        </div>
                                    </td>

                                    <td>
                                        <div class="font-weight-bold text-dark mb-1">@item.TieuDe</div>
                                        <small class="text-muted">ID: @shortId...</small>
                                    </td>

                                    <td>
                                        <div class="text-danger font-weight-bold">@item.GiaTien.ToString("N0") đ</div>
                                        @if (item.DienTich.HasValue)
                                        {
                                            <small class="text-secondary">@item.DienTich.Value.ToString("N0") m²</small>
                                        }
                                    </td>

                                    <td>
                                        <div>@(string.IsNullOrEmpty(item.TenNhaTro) ? "Chưa cập nhật" : item.TenNhaTro)</div>
                                    </td>

                                    <td>
                                        <span class="badge @item.BadgeClass px-3 py-2" style="font-size: 0.85rem; border-radius: 20px;">
                                            @item.HienThiTrangThai
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("SuaPhong", "ChuTro", new { id = item.PhongId })"
                                               class="btn btn-sm btn-outline-info" title="Sửa">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            <a href="@Url.Action("XoaPhong", "ChuTro", new { id = item.PhongId })"
                                               class="btn btn-sm btn-outline-danger" title="Xóa"
                                               onclick="return confirm('Bạn có chắc chắn muốn xóa phòng này?');">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" width="100" class="mb-3 opacity-50" />
                    <h5 class="text-muted mt-3">Bạn chưa có phòng trọ nào.</h5>
                    <a href="@Url.Action("TaoPhong", "ChuTro")" class="btn btn-primary mt-2">
                        <i class="fas fa-plus mr-1"></i>Thêm phòng ngay
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table td {
        vertical-align: middle;
    }
    .badge-success {
        background-color: #28a745;
        color: white;
    }
    .badge-warning {
        background-color: #ffc107;
        color: #212529;
    }
    .badge-danger {
        background-color: #dc3545;
        color: white;
    }
    .badge-secondary {
        background-color: #6c757d;
        color: white;
    }
</style>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
}
