@model List<USER_QUANLYPHONGTRO.Models.ViewModels.ChuTro.QuanLyPhongViewModel>

@{
    ViewBag.Title = "Quản lý phòng trọ";
    Layout = "~/Views/Shared/_ChutroLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Danh sách phòng trọ</h1>
        <a href="@Url.Action("TaoPhong", "ChuTro")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Thêm phòng mới
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Dữ liệu phòng của bạn</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            <th>Ảnh</th>
                            <th>Tên phòng</th>
                            <th>Khu trọ</th>
                            <th>Giá (VNĐ)</th>
                            <th>Trạng thái</th>
                            <th>Kiểm duyệt</th>
                            <th style="width: 120px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">
                                        <img src="@item.AnhDaiDien" alt="Room" style="width: 60px; height: 60px; object-fit: cover; border-radius: 5px;"
                                             onerror="this.onerror=null; this.src='/images/logo.png';" />
                                    </td>
                                    <td class="font-weight-bold text-primary">@item.TenPhong</td>
                                    <td>@item.TenNhaTro</td>
                                    <td class="text-danger font-weight-bold">@item.GiaTien.ToString("N0")</td>
                                    <td>
                                        @if (item.TrangThai == "Đã thuê")
                                        {
                                            <span class="badge badge-secondary">Đã thuê</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success">Còn trống</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsDuyet)
                                        {
                                            <span class="text-success small"><i class="fa fa-check-circle"></i> Đã duyệt</span>
                                        }
                                        else
                                        {
                                            <span class="text-warning small"><i class="fa fa-clock"></i> Chờ duyệt</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("SuaPhong", "ChuTro", new { id = item.PhongId })" class="btn btn-info btn-circle btn-sm" title="Sửa">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <a href="#" class="btn btn-danger btn-circle btn-sm" title="Xóa" onclick="confirmDelete('@item.PhongId')">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <img src="https://cdn-icons-png.flaticon.com/512/4076/4076432.png" width="64" class="mb-3 opacity-50" />
                                    <p class="text-muted">Bạn chưa đăng phòng trọ nào.</p>
                                    <a href="@Url.Action("TaoPhong", "ChuTro")" class="btn btn-primary btn-sm">Đăng ngay</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function confirmDelete(id) {
        if(confirm('Bạn có chắc chắn muốn xóa phòng này không?')) {
            // Gọi API xóa hoặc Action xóa
            // window.location.href = '/ChuTro/XoaPhong/' + id;
            alert('Chức năng xóa sẽ được cập nhật sau.');
        }
    }
</script>