@{
    ViewBag.Title = "Tin nhắn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
<style>
    /* Chat App Styles */
    .chat-wrapper {
        display: flex;
        height: calc(100vh - 180px);
        min-height: 500px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        overflow: hidden;
        margin: 20px 0;
    }

    /* Sidebar - danh sách cuộc trò chuyện */
    .chat-sidebar {
        width: 320px;
        border-right: 1px solid #e5e7eb;
        display: flex;
        flex-direction: column;
        background: #f9fafb;
    }

    .chat-sidebar-header {
        padding: 20px;
        background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
        color: white;
    }

    .chat-sidebar-header h3 {
        margin: 0;
        font-size: 18px;
        font-weight: 600;
    }

    .chat-sidebar-header .user-info {
        display: flex;
        align-items: center;
        margin-top: 10px;
        font-size: 13px;
        opacity: 0.9;
    }

    .chat-sidebar-header .online-dot {
        width: 8px;
        height: 8px;
        background: #22c55e;
        border-radius: 50%;
        margin-right: 6px;
    }

    .conversation-list {
        flex: 1;
        overflow-y: auto;
    }

    .conversation-item {
        display: flex;
        align-items: center;
        padding: 15px 20px;
        cursor: pointer;
        border-bottom: 1px solid #f3f4f6;
        transition: all 0.2s;
    }

    .conversation-item:hover {
        background: #eff6ff;
    }

    .conversation-item.active {
        background: #dbeafe;
        border-left: 3px solid #3b82f6;
    }

    .conversation-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 18px;
        margin-right: 12px;
        flex-shrink: 0;
    }

    .conversation-info {
        flex: 1;
        min-width: 0;
    }

    .conversation-name {
        font-weight: 600;
        font-size: 14px;
        color: #1f2937;
        margin-bottom: 4px;
    }

    .conversation-preview {
        font-size: 12px;
        color: #6b7280;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .conversation-meta {
        text-align: right;
    }

    .conversation-time {
        font-size: 11px;
        color: #9ca3af;
    }

    .unread-badge {
        background: #ef4444;
        color: white;
        font-size: 10px;
        padding: 2px 6px;
        border-radius: 10px;
        margin-top: 5px;
        display: inline-block;
    }

    /* Main Chat Area */
    .chat-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #fff;
    }

    .chat-header {
        padding: 15px 25px;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: white;
    }

    .chat-header-left {
        display: flex;
        align-items: center;
    }

    .chat-header .avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 16px;
        margin-right: 12px;
    }

    .chat-header-info h4 {
        margin: 0;
        font-size: 16px;
        color: #1f2937;
    }

    .chat-header-info .status {
        font-size: 12px;
        color: #22c55e;
    }

    .chat-header-actions {
        display: flex;
        gap: 10px;
    }

    .chat-header-actions button {
        background: #f3f4f6;
        border: none;
        padding: 8px 12px;
        border-radius: 8px;
        cursor: pointer;
        color: #4b5563;
        transition: all 0.2s;
    }

    .chat-header-actions button:hover {
        background: #e5e7eb;
        color: #1f2937;
    }

    /* Messages Area */
    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px 25px;
        background: #f9fafb;
    }

    .message-group {
        margin-bottom: 20px;
    }

    .message-date {
        text-align: center;
        margin-bottom: 15px;
    }

    .message-date span {
        background: #e5e7eb;
        color: #6b7280;
        font-size: 11px;
        padding: 4px 12px;
        border-radius: 12px;
    }

    .message {
        display: flex;
        margin-bottom: 10px;
        align-items: flex-end;
    }

    .message.sent {
        justify-content: flex-end;
    }

    .message.received {
        justify-content: flex-start;
    }

    .message-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 12px;
        margin-right: 8px;
        flex-shrink: 0;
    }

    .message.sent .message-avatar {
        display: none;
    }

    .message-content {
        max-width: 65%;
    }

    .message-bubble {
        padding: 12px 16px;
        border-radius: 18px;
        font-size: 14px;
        line-height: 1.4;
        word-wrap: break-word;
    }

    .message.sent .message-bubble {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: white;
        border-bottom-right-radius: 4px;
    }

    .message.received .message-bubble {
        background: white;
        color: #1f2937;
        border: 1px solid #e5e7eb;
        border-bottom-left-radius: 4px;
    }

    .message-time {
        font-size: 10px;
        color: #9ca3af;
        margin-top: 4px;
        text-align: right;
    }

    .message.received .message-time {
        text-align: left;
    }

    /* Chat Input */
    .chat-input-area {
        padding: 15px 25px;
        border-top: 1px solid #e5e7eb;
        background: white;
    }

    .chat-input-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #f3f4f6;
        padding: 8px 15px;
        border-radius: 25px;
    }

    .chat-input-wrapper input {
        flex: 1;
        border: none;
        background: transparent;
        padding: 8px 0;
        font-size: 14px;
        outline: none;
    }

    .chat-input-wrapper input::placeholder {
        color: #9ca3af;
    }

    .input-actions {
        display: flex;
        gap: 8px;
    }

    .input-actions button {
        background: none;
        border: none;
        color: #6b7280;
        cursor: pointer;
        padding: 5px;
        border-radius: 50%;
        transition: all 0.2s;
    }

    .input-actions button:hover {
        background: #e5e7eb;
        color: #3b82f6;
    }

    .send-btn {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%) !important;
        color: white !important;
        padding: 10px 20px !important;
        border-radius: 20px !important;
        font-weight: 500;
    }

    .send-btn:hover {
        opacity: 0.9;
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%) !important;
    }

    /* Empty State */
    .empty-chat {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #9ca3af;
    }

    .empty-chat i {
        font-size: 64px;
        margin-bottom: 20px;
        color: #d1d5db;
    }

    .empty-chat h4 {
        font-size: 18px;
        color: #6b7280;
        margin-bottom: 8px;
    }

    .empty-chat p {
        font-size: 14px;
    }

    /* Connection Status */
    .connection-status {
        padding: 8px 20px;
        background: #fef3c7;
        color: #92400e;
        font-size: 12px;
        text-align: center;
        display: none;
    }

    .connection-status.connected {
        background: #d1fae5;
        color: #065f46;
    }

    .connection-status.error {
        background: #fee2e2;
        color: #991b1b;
    }

    .connection-status.show {
        display: block;
    }

    /* Typing indicator */
    .typing-indicator {
        display: none;
        padding: 10px 20px;
        color: #6b7280;
        font-size: 13px;
        font-style: italic;
    }

    .typing-indicator.show {
        display: block;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .chat-wrapper {
            flex-direction: column;
            height: auto;
        }

        .chat-sidebar {
            width: 100%;
            max-height: 200px;
        }

        .chat-main {
            height: 400px;
        }
    }
</style>
}

<div class="container-fluid">
    <!-- Connection Status Banner -->
    <div id="connectionStatus" class="connection-status">
        <i class="fas fa-circle-notch fa-spin"></i> Đang kết nối đến server chat...
    </div>

    <div class="chat-wrapper">
        <!-- Sidebar - Danh sách cuộc trò chuyện -->
        <div class="chat-sidebar">
            <div class="chat-sidebar-header">
                <h3><i class="fas fa-comments"></i> Tin nhắn</h3>
                <div class="user-info">
                    <span class="online-dot"></span>
                    <span id="currentUserName">@ViewBag.UserName</span>
                </div>
            </div>

            <div class="conversation-list" id="conversationList">
                <!-- Cuộc trò chuyện mặc định - Cộng đồng -->
                <div class="conversation-item active" onclick="selectConversation('[Nhóm] Cộng đồng TroTot', 'CT')">
                    <div class="conversation-avatar">CT</div>
                    <div class="conversation-info">
                        <div class="conversation-name">[Nhóm] Cộng đồng TroTot</div>
                        <div class="conversation-preview">Chào mừng bạn đến với cộng đồng!</div>
                    </div>
                </div>
                <!-- Các cuộc hội thoại khác sẽ được load động -->
            </div>
        </div>

        <!-- Main Chat Area -->
        <div class="chat-main">
            <div class="chat-header">
                <div class="chat-header-left">
                    <div class="avatar" id="chatAvatar">CT</div>
                    <div class="chat-header-info">
                        <h4 id="chatName">[Nhóm] Cộng đồng TroTot</h4>
                        <div class="status" id="chatStatus">
                            <i class="fas fa-circle" style="font-size: 8px;"></i> Đang hoạt động
                        </div>
                    </div>
                </div>
                <div class="chat-header-actions">
                    <button title="Gọi điện"><i class="fas fa-phone"></i></button>
                    <button title="Video call"><i class="fas fa-video"></i></button>
                    <button title="Thông tin"><i class="fas fa-info-circle"></i></button>
                </div>
            </div>

            <!-- Messages Container -->
            <div class="chat-messages" id="chatMessages">
                <div class="message-date">
                    <span>Hôm nay</span>
                </div>

                <!-- Tin nhắn mẫu -->
                <div class="message received">
                    <div class="message-avatar">S</div>
                    <div class="message-content">
                        <div class="message-bubble">Chào mừng bạn đến với hệ thống chat TroTot! 🏠</div>
                        <div class="message-time">09:00</div>
                    </div>
                </div>
            </div>

            <!-- Typing Indicator -->
            <div class="typing-indicator" id="typingIndicator">
                <i class="fas fa-ellipsis-h"></i> Đang nhập tin nhắn...
            </div>

            <!-- Chat Input -->
            <div class="chat-input-area">
                <div class="chat-input-wrapper">
                    <div class="input-actions">
                        <button type="button" title="Đính kèm file"><i class="fas fa-paperclip"></i></button>
                        <button type="button" title="Emoji"><i class="fas fa-smile"></i></button>
                    </div>
                    <input type="text" id="messageInput" placeholder="Nhập tin nhắn..." onkeypress="handleKeyPress(event)">
                    <button class="send-btn" onclick="sendMessage()">
                        <i class="fas fa-paper-plane"></i> Gửi
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/sockjs-client@1/dist/sockjs.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/stompjs@2.3.3/lib/stomp.min.js"></script>

<script>
    // ===== CONFIGURATION =====
    var WS_URL = '@ViewBag.WebSocketUrl';
    var currentUser = '@ViewBag.UserName';
    var currentUserId = '@ViewBag.UserId';

    // ===== STATE =====
    var stompClient = null;
    var userOnlines = [];
    var chats = [];
    var selectedConversation = '[Nhóm] Cộng đồng TroTot';
    var isConnected = false;

    // ===== INITIALIZATION =====
    $(document).ready(function() {
        console.log('[Chat] Khởi tạo với user:', currentUser);
        connect();
        loadChatHistory();
    });

    // ===== WEBSOCKET CONNECTION =====
    function connect() {
        showConnectionStatus('connecting', 'Đang kết nối đến server chat...');

        try {
            var socket = new SockJS(WS_URL);
            stompClient = Stomp.over(socket);

            // Disable debug logging in production
            stompClient.debug = function(str) {
                console.log('[STOMP]', str);
            };

            stompClient.connect({}, function(frame) {
                console.log('[Chat] Kết nối thành công:', frame);
                isConnected = true;
                showConnectionStatus('connected', 'Đã kết nối thành công!');

                // Subscribe to topics
                stompClient.subscribe('/topic/new-message', function(messageOutput) {
                    onNewMessage(JSON.parse(messageOutput.body));
                });

                stompClient.subscribe('/topic/new-user', function(message) {
                    onNewUser(message.body);
                });

                stompClient.subscribe('/topic/new-group', function(messageOutput) {
                    onNewGroup(JSON.parse(messageOutput.body));
                });

                // Login to chat server
                loginToChat();

                // Hide status after 2 seconds
                setTimeout(function() {
                    hideConnectionStatus();
                }, 2000);

            }, function(error) {
                console.error('[Chat] Lỗi kết nối:', error);
                isConnected = false;
                showConnectionStatus('error', 'Không thể kết nối. Đang thử lại...');

                // Retry after 5 seconds
                setTimeout(connect, 5000);
            });

        } catch (e) {
            console.error('[Chat] Exception:', e);
            showConnectionStatus('error', 'Lỗi: ' + e.message);
        }
    }

    function disconnect() {
        if (stompClient != null) {
            stompClient.disconnect();
        }
        isConnected = false;
        console.log('[Chat] Đã ngắt kết nối');
    }

    function loginToChat() {
        fetch(WS_URL.replace('/ws', '') + '/api/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username: currentUser })
        })
        .then(function(res) {
            if (res.ok) return res.json();
            throw new Error('Login failed');
        })
        .then(function(data) {
            console.log('[Chat] Login thành công, users online:', data);
            userOnlines = data || [];
            renderConversationList();
        })
        .catch(function(error) {
            console.error('[Chat] Login error:', error);
        });
    }

    // ===== MESSAGE FUNCTIONS =====
    function sendMessage() {
        var text = $('#messageInput').val().trim();
        if (!text || !isConnected) return;

        var message = {
            from: currentUser,
            to: selectedConversation,
            text: text
        };

        stompClient.send("/app/chat", {}, JSON.stringify(message));
        $('#messageInput').val('');

        // Hiển thị tin nhắn đã gửi ngay lập tức
        appendMessage(message, true);
    }

    function handleKeyPress(event) {
        if (event.key === 'Enter') {
            sendMessage();
        }
    }

    function onNewMessage(message) {
        console.log('[Chat] Tin nhắn mới:', message);
        chats.push(message);

        // Nếu là tin nhắn cho cuộc trò chuyện đang mở
        if (isMessageForCurrentConversation(message)) {
            if (message.from !== currentUser) {
                appendMessage(message, false);
            }
        } else {
            // Thông báo tin nhắn mới
            if (message.from !== currentUser) {
                showNotification('Tin nhắn mới từ: ' + message.from);
            }
        }
    }

    function isMessageForCurrentConversation(message) {
        if (selectedConversation.startsWith('[Nhóm]')) {
            return message.to === selectedConversation;
        } else {
            return (message.from === currentUser && message.to === selectedConversation) ||
                   (message.from === selectedConversation && message.to === currentUser);
        }
    }

    function appendMessage(message, isSent) {
        var time = new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
        var initials = message.from.charAt(0).toUpperCase();

        var html = `
            <div class="message ${isSent ? 'sent' : 'received'}">
                ${!isSent ? `<div class="message-avatar">${initials}</div>` : ''}
                <div class="message-content">
                    <div class="message-bubble">${escapeHtml(message.text)}</div>
                    <div class="message-time">${time}</div>
                </div>
            </div>
        `;

        $('#chatMessages').append(html);
        scrollToBottom();
    }

    // ===== USER/GROUP FUNCTIONS =====
    function onNewUser(username) {
        if (username !== currentUser && !userOnlines.includes(username)) {
            userOnlines.push(username);
            renderConversationList();
            showNotification(username + ' vừa tham gia chat!');
        }
    }

    function onNewGroup(group) {
        console.log('[Chat] Group mới:', group);
        renderConversationList();
    }

    // ===== UI FUNCTIONS =====
    function selectConversation(name, initials) {
        selectedConversation = name;
        
        // Update header
        $('#chatName').text(name);
        $('#chatAvatar').text(initials);

        // Update active state
        $('.conversation-item').removeClass('active');
        event.currentTarget.classList.add('active');

        // Clear and reload messages
        $('#chatMessages').html('<div class="message-date"><span>Hôm nay</span></div>');
        renderMessagesForConversation();
    }

    function renderConversationList() {
        var html = '';

        // Nhóm cộng đồng mặc định
        var isActive = selectedConversation === '[Nhóm] Cộng đồng TroTot' ? 'active' : '';
        html += `
            <div class="conversation-item ${isActive}" onclick="selectConversation('[Nhóm] Cộng đồng TroTot', 'CT')">
                <div class="conversation-avatar">CT</div>
                <div class="conversation-info">
                    <div class="conversation-name">[Nhóm] Cộng đồng TroTot</div>
                    <div class="conversation-preview">Chào mừng đến với cộng đồng!</div>
                </div>
            </div>
        `;

        // Các user online
        userOnlines.forEach(function(username) {
            if (username === currentUser) return;
            var initials = username.charAt(0).toUpperCase();
            var isActive = selectedConversation === username ? 'active' : '';
            html += `
                <div class="conversation-item ${isActive}" onclick="selectConversation('${username}', '${initials}')">
                    <div class="conversation-avatar">${initials}</div>
                    <div class="conversation-info">
                        <div class="conversation-name">${username}</div>
                        <div class="conversation-preview"><span style="color: #22c55e;">●</span> Đang hoạt động</div>
                    </div>
                </div>
            `;
        });

        $('#conversationList').html(html);
    }

    function renderMessagesForConversation() {
        var filteredChats = chats.filter(function(chat) {
            if (selectedConversation.startsWith('[Nhóm]')) {
                return chat.to === selectedConversation;
            } else {
                return (chat.from === currentUser && chat.to === selectedConversation) ||
                       (chat.from === selectedConversation && chat.to === currentUser);
            }
        });

        filteredChats.forEach(function(chat) {
            var isSent = chat.from === currentUser;
            appendMessage(chat, isSent);
        });
    }

    function loadChatHistory() {
        fetch(WS_URL.replace('/ws', '') + '/api/chats')
            .then(function(res) { return res.json(); })
            .then(function(data) {
                chats = data || [];
                console.log('[Chat] Loaded', chats.length, 'messages');
                renderMessagesForConversation();
            })
            .catch(function(error) {
                console.error('[Chat] Load history error:', error);
            });
    }

    // ===== HELPER FUNCTIONS =====
    function showConnectionStatus(type, message) {
        var $status = $('#connectionStatus');
        $status.removeClass('connected error').addClass('show');
        
        if (type === 'connected') {
            $status.addClass('connected').html('<i class="fas fa-check-circle"></i> ' + message);
        } else if (type === 'error') {
            $status.addClass('error').html('<i class="fas fa-exclamation-circle"></i> ' + message);
        } else {
            $status.html('<i class="fas fa-circle-notch fa-spin"></i> ' + message);
        }
    }

    function hideConnectionStatus() {
        $('#connectionStatus').removeClass('show');
    }

    function scrollToBottom() {
        var chatMessages = document.getElementById('chatMessages');
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function escapeHtml(text) {
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function showNotification(message) {
        // Có thể thêm toast notification ở đây
        console.log('[Notification]', message);
    }

    // Cleanup khi đóng trang
    $(window).on('beforeunload', function() {
        disconnect();
    });
</script>
}
