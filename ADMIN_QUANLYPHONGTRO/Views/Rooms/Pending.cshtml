@{
    ViewBag.Title = "Phòng Chờ Duyệt";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@section styles {
    <link rel="stylesheet" href="~/Content/css/pages/rooms.css?v=@DateTime.Now.Ticks" />
}

<!-- Page Header -->
<div class="page-header">
    <h4 class="page-title">Quản lý phòng trọ</h4>
    <ul class="breadcrumbs">
        <li class="nav-home">
            <a href="@Url.Action("Index", "Dashboard")">
                <i class="flaticon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="flaticon-right-arrow"></i>
        </li>
        <li class="nav-item">
            <a href="#">Quản lý phòng</a>
        </li>
        <li class="separator">
            <i class="flaticon-right-arrow"></i>
        </li>
        <li class="nav-item">
            <a href="#">
                @if (ViewBag.Status == "approved")
                {
                    <text>Phòng đã duyệt</text>
                }
                else if (ViewBag.Status == "locked")
                {
                    <text>Phòng bị khóa</text>
                }
                else
                {
                    <text>Phòng chờ duyệt</text>
                }
            </a>
        </li>
    </ul>
</div>

<!-- Main Content Card -->
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center flex-wrap" style="gap: 10px;">
                    <h4 class="card-title mb-0">
                        <i class="fa fa-door-open mr-2"></i>
                        @if (ViewBag.Status == "approved")
                        {
                            <text>Phòng Đã Duyệt</text>
                        }
                        else if (ViewBag.Status == "locked")
                        {
                            <text>Phòng Bị Khóa</text>
                        }
                        else
                        {
                            <text>Phòng Chờ Duyệt</text>
                        }
                    </h4>
                    <button class="btn btn-sm btn-outline-primary ml-auto" onclick="RoomsPage.refreshTable()">
                        <i class="fa fa-sync-alt mr-1"></i> Làm mới
                    </button>
                </div>
            </div>
            <div class="card-body">
                <!-- Filter & Search Section -->
                <div class="filter-section">
                    <div class="row">
                        <div class="col-md-4 col-sm-6 mb-3 mb-md-0">
                            <div class="form-group">
                                <label><i class="fa fa-toggle-on mr-1"></i> Trạng thái</label>
                                <select class="form-control" id="filterStatus">
                                    <option value="">Tất cả trạng thái</option>
                                    <option value="pending" selected>Chờ duyệt</option>
                                    <option value="approved">Đã duyệt</option>
                                    <option value="locked">Bị khóa</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-5 col-sm-8 mb-3 mb-md-0">
                            <div class="form-group">
                                <label><i class="fa fa-search mr-1"></i> Tìm kiếm</label>
                                <input type="text" class="form-control" id="filterKeyword" 
                                       placeholder="Tìm theo tiêu đề, chủ trọ, địa điểm...">
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-4 d-flex align-items-end">
                            <button type="button" class="btn btn-primary btn-block" id="btnApplyFilter">
                                <i class="fa fa-search mr-1"></i> Tìm kiếm
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Data Table -->
                <div class="table-responsive">
                    <table id="roomsTable" class="display table table-striped table-hover">
                        <thead>
                            <tr>
                                <th style="width: 25px;">STT</th>
                                <th style="width: 250px;">Phòng</th>
                                <th style="width: 80px;">Diện Tích</th>
                                <th style="width: 120px;">Giá Tiền</th>
                                <th style="width: 120px;">Chủ Trọ</th>
                                <th style="width: 100px;">Ngày Tạo</th>
                                <th style="width: 100px;">Trạng Thái</th>
                                <th style="width: 120px; text-align: center;">Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chi tiết phòng -->
<div class="modal fade room-detail-modal" id="roomDetailModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa fa-door-open mr-2"></i>
                    Chi tiết phòng
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Loading State -->
                <div id="roomDetailLoading" class="text-center py-5">
                    <div class="loading-spinner mx-auto"></div>
                    <p class="mt-3 text-muted">Đang tải thông tin...</p>
                </div>

                <!-- Room Detail Content -->
                <div id="roomDetailContent" style="display: none;">
                    <div class="row">
                        <!-- Cột Trái: Hình ảnh -->
                        <div class="col-lg-6">
                            <div class="room-images-section">
                                <h6><i class="fa fa-images"></i> Hình ảnh phòng</h6>
                                <div class="room-image-grid" id="roomImageGrid">
                                    <!-- Images will be loaded here -->
                                </div>
                            </div>
                        </div>

                        <!-- Cột Phải: Thông tin -->
                        <div class="col-lg-6">
                            <div class="room-info-section">
                                <h6><i class="fa fa-info-circle"></i> Thông tin phòng</h6>

                                <div class="info-row">
                                    <span class="info-label">Tiêu đề:</span>
                                    <span class="info-value" id="detailTieuDe"></span>
                                </div>

                                <div class="info-row">
                                    <span class="info-label">Diện tích:</span>
                                    <span class="info-value" id="detailDienTich"></span>
                                </div>

                                <div class="info-row">
                                    <span class="info-label">Giá tiền:</span>
                                    <span class="info-value" id="detailGiaTien"></span>
                                </div>

                                <div class="info-row">
                                    <span class="info-label">Tiền cọc:</span>
                                    <span class="info-value" id="detailTienCoc"></span>
                                </div>

                                <div class="info-row">
                                    <span class="info-label">Số người tối đa:</span>
                                    <span class="info-value" id="detailSoNguoi"></span>
                                </div>

                                <div class="info-row">
                                    <span class="info-label">Chủ trọ:</span>
                                    <span class="info-value" id="detailChuTro"></span>
                                </div>

                                <div class="info-row">
                                    <span class="info-label">Nhà trọ:</span>
                                    <span class="info-value" id="detailNhaTro"></span>
                                </div>

                                <div class="info-row">
                                    <span class="info-label">Trạng thái:</span>
                                    <span class="info-value" id="detailTrangThai"></span>
                                </div>
                            </div>

                            <!-- Reject Reason Section -->
                            <div class="reject-reason-section">
                                <label for="rejectReason">
                                    <i class="fa fa-comment-alt"></i> Lý do từ chối (bắt buộc khi từ chối)
                                </label>
                                <textarea class="form-control" id="rejectReason" rows="3" 
                                          placeholder="Ví dụ: Hình ảnh không phù hợp, thông tin chưa đầy đủ..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    <i class="fa fa-times mr-1"></i> Đóng
                </button>
                <button type="button" class="btn btn-danger" id="btnModalReject" onclick="RoomsPage.rejectRoom()">
                    <i class="fa fa-ban mr-1"></i> Từ chối
                </button>
                <button type="button" class="btn btn-success" id="btnModalApprove" onclick="RoomsPage.approveRoom()">
                    <i class="fa fa-check mr-1"></i> Duyệt phòng
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.10.24/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.24/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/Scripts/pages/rooms.js?v=@DateTime.Now.Ticks"></script>
    
    <script>
        $(function () {
            // Khởi tạo RoomsPage với các URLs
            RoomsPage.init({
                getPendingRooms: '@Url.Action("GetPendingRooms", "Rooms")',
                getRoomDetail: '@Url.Action("GetRoomDetail", "Rooms")',
                approveRoom: '@Url.Action("ApproveRoom", "Rooms")',
                rejectRoom: '@Url.Action("RejectRoom", "Rooms")',
                toggleLockRoom: '@Url.Action("ToggleLockRoom", "Rooms")',
                getRoomStats: '@Url.Action("GetRoomStats", "Rooms")'
            });
        });
    </script>
}

