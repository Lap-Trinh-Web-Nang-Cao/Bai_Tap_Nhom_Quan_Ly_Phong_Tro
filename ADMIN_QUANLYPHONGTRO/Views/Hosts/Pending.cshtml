@model List<ADMIN_QUANLYPHONGTRO.Models.ViewModels.HostPendingItemViewModel>

@{
    ViewBag.Title = "Duyệt chủ trọ";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@section styles {
    <link rel="stylesheet" href="~/Content/css/pages/hosts.css?v=@DateTime.Now.Ticks" />
}

<!-- Page Header -->
<div class="page-header">
    <h4 class="page-title">Duyệt chủ trọ</h4>
    <ul class="breadcrumbs">
        <li class="nav-home">
            <a href="@Url.Action("Index", "Dashboard")">
                <i class="flaticon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="flaticon-right-arrow"></i>
        </li>
        <li class="nav-item">
            <a href="#">Quản lý người dùng</a>
        </li>
        <li class="separator">
            <i class="flaticon-right-arrow"></i>
        </li>
        <li class="nav-item">
            <a href="#">Duyệt chủ trọ</a>
        </li>
    </ul>
</div>

<!-- Main Content Card -->
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center flex-wrap" style="gap: 10px;">
                    <h4 class="card-title mb-0">
                        <i class="fa fa-user-check mr-2"></i>Duyệt chủ trọ
                    </h4>
                    <button class="btn btn-sm btn-outline-primary ml-auto" onclick="HostsPage.applyFilter()">
                        <i class="fa fa-sync-alt mr-1"></i> Làm mới
                    </button>
                </div>
            </div>
            <div class="card-body">
                <!-- Filter & Search Section -->
                <div class="filter-section">
                    <div class="row">
                        <div class="col-md-4 col-sm-6 mb-3 mb-md-0">
                            <div class="form-group">
                                <label><i class="fa fa-toggle-on mr-1"></i> Trạng thái</label>
                                <select class="form-control" id="filterStatus">
                                    <option value="">Tất cả trạng thái</option>
                                    <option value="pending" selected>Chờ duyệt</option>
                                    <option value="approved">Đã xác minh</option>
                                    <option value="rejected">Từ chối</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-5 col-sm-8 mb-3 mb-md-0">
                            <div class="form-group">
                                <label><i class="fa fa-search mr-1"></i> Tìm kiếm</label>
                                <input type="text" class="form-control" id="filterKeyword" 
                                       placeholder="Tìm theo tên, email, điện thoại, CCCD...">
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-4 d-flex align-items-end">
                            <button type="button" class="btn btn-primary btn-block" id="btnApplyFilter">
                                <i class="fa fa-search mr-1"></i> Tìm kiếm
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Data Table -->
                <div class="table-responsive">
                    <table id="hostsTable" class="display table table-striped table-hover">
                        <thead>
                            <tr>
                                <th style="width: 280px;">Chủ trọ</th>
                                <th style="width: 120px;">Điện thoại</th>
                                <th style="width: 130px;">CCCD/CMND</th>
                                <th style="width: 110px;">Giấy tờ</th>
                                <th style="width: 100px;">Ngày đăng ký</th>
                                <th style="width: 100px;">Trạng thái</th>
                                <th style="width: 120px; text-align: center;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chi tiết và Duyệt/Từ chối -->
<div class="modal fade host-detail-modal" id="hostDetailModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa fa-user-check mr-2"></i>
                    Kiểm tra hồ sơ chủ trọ
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Loading State -->
                <div id="hostDetailLoading" class="text-center py-5">
                    <div class="loading-spinner mx-auto"></div>
                    <p class="mt-3 text-muted">Đang tải thông tin...</p>
                </div>

                <!-- Host Detail Content -->
                <div id="hostDetailContent" style="display: none;">
                    <div class="row">
                        <!-- Cột Trái: Hình ảnh giấy tờ -->
                        <div class="col-lg-6">
                            <div class="document-preview-section">
                                <h6><i class="fa fa-id-card"></i> Giấy tờ tùy thân</h6>
                                
                                <div class="row">
                                    <div class="col-6">
                                        <div class="document-card">
                                            <div class="doc-label">CCCD Mặt trước</div>
                                            <img id="detailCCCDFront" src="/Content/img/no-image.png" 
                                                 alt="CCCD Mặt trước" class="doc-image"
                                                 onerror="this.src='/Content/img/no-image.png';">
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="document-card">
                                            <div class="doc-label">CCCD Mặt sau</div>
                                            <img id="detailCCCDBack" src="/Content/img/no-image.png" 
                                                 alt="CCCD Mặt sau" class="doc-image"
                                                 onerror="this.src='/Content/img/no-image.png';">
                                        </div>
                                    </div>
                                </div>

                                <div class="document-card">
                                    <div class="doc-label">Giấy phép kinh doanh (nếu có)</div>
                                    <img id="detailBusinessLicense" src="/Content/img/no-image.png" 
                                         alt="Giấy phép kinh doanh" class="doc-image"
                                         onerror="this.src='/Content/img/no-image.png';">
                                </div>

                                <small class="text-muted d-block mt-2">
                                    <i class="fa fa-info-circle"></i> Click vào ảnh để xem phóng to
                                </small>
                            </div>
                        </div>

                        <!-- Cột Phải: Thông tin cá nhân -->
                        <div class="col-lg-6">
                            <div class="info-section">
                                <h6><i class="fa fa-user"></i> Thông tin cá nhân</h6>

                                <div class="info-row">
                                    <span class="info-label">Họ và tên:</span>
                                    <input type="text" class="form-control form-control-sm" id="detailHoTen" readonly>
                                </div>

                                <div class="info-row">
                                    <span class="info-label">Email:</span>
                                    <input type="email" class="form-control form-control-sm" id="detailEmail" readonly>
                                </div>

                                <div class="info-row">
                                    <span class="info-label">Số điện thoại:</span>
                                    <input type="text" class="form-control form-control-sm" id="detailDienThoai" readonly>
                                </div>

                                <div class="info-row">
                                    <span class="info-label">Số CCCD:</span>
                                    <input type="text" class="form-control form-control-sm" id="detailSoCCCD" readonly>
                                </div>

                                <div class="info-row">
                                    <span class="info-label">Ngày sinh:</span>
                                    <input type="text" class="form-control form-control-sm" id="detailNgaySinh" readonly>
                                </div>

                                <div class="info-row">
                                    <span class="info-label">Quê quán:</span>
                                    <input type="text" class="form-control form-control-sm" id="detailQueQuan" readonly>
                                </div>
                            </div>

                            <!-- Reject Reason Section -->
                            <div class="reject-reason-section">
                                <label for="rejectReason">
                                    <i class="fa fa-comment-alt"></i> Lý do từ chối (bắt buộc khi từ chối)
                                </label>
                                <textarea class="form-control" id="rejectReason" rows="3" 
                                          placeholder="Ví dụ: Ảnh CCCD bị mờ, thông tin không khớp..."></textarea>
                            </div>

                            <!-- Status Note -->
                            <div id="modalStatusNote" class="alert alert-info mt-3" style="display: none;">
                                <i class="fa fa-info-circle mr-2"></i>
                                <span></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    <i class="fa fa-times mr-1"></i> Đóng
                </button>
                <button type="button" class="btn btn-danger" id="btnModalReject" onclick="HostsPage.rejectHost()">
                    <i class="fa fa-ban mr-1"></i> Từ chối
                </button>
                <button type="button" class="btn btn-success" id="btnModalApprove" onclick="HostsPage.approveHost()">
                    <i class="fa fa-check mr-1"></i> Xác thực
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Lightbox for Image Preview -->
<div class="lightbox-overlay">
    <div class="lightbox-content">
        <span class="lightbox-close">&times;</span>
        <img src="" alt="Preview" />
    </div>
</div>

@section scripts {
    <script src="~/Scripts/pages/hosts.js?v=@DateTime.Now.Ticks"></script>
    <script>
        $(document).ready(function() {
            // Khởi tạo HostsPage với các URLs
            HostsPage.init({
                getPendingHosts: '@Url.Action("GetPendingHosts", "Hosts")',
                getHostDetail: '@Url.Action("GetHostDetail", "Hosts")',
                approveHost: '@Url.Action("ApproveHost", "Hosts")',
                rejectHost: '@Url.Action("RejectHost", "Hosts")',
                getHostStats: '@Url.Action("GetHostStats", "Hosts")'
            });
        });
    </script>
}