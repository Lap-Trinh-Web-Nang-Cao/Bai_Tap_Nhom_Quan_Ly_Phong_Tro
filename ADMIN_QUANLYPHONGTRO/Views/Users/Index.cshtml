@model IEnumerable<ADMIN_QUANLYPHONGTRO.Models.ViewModels.UserItemViewModel>

@{
    ViewBag.Title = "Quản lý người dùng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@section styles {
    <link rel="stylesheet" href="~/Content/css/pages/users.css?v=@DateTime.Now.Ticks" />
}

<!-- Page Header -->
<div class="page-header">
    <h4 class="page-title">Quản lý người dùng</h4>
    <ul class="breadcrumbs">
        <li class="nav-home">
            <a href="@Url.Action("Index", "Dashboard")">
                <i class="flaticon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="flaticon-right-arrow"></i>
        </li>
        <li class="nav-item">
            <a href="#">Người dùng</a>
        </li>
        <li class="separator">
            <i class="flaticon-right-arrow"></i>
        </li>
        <li class="nav-item">
            <a href="#">Danh sách</a>
        </li>
    </ul>
</div>

<!-- Main Content Card -->
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center flex-wrap" style="gap: 10px;">
                    <h4 class="card-title mb-0">Danh sách người dùng</h4>
                    <button class="btn btn-primary btn-round ml-auto" data-toggle="modal" data-target="#addUserModal">
                        <i class="fa fa-plus"></i>
                        Thêm người dùng
                    </button>
                </div>
            </div>
            <div class="card-body">
                <!-- Filter & Search Section -->
                <div class="filter-section">
                    <div class="row">
                        <div class="col-md-3 col-sm-6 mb-3 mb-md-0">
                            <div class="form-group">
                                <label><i class="fa fa-user-tag mr-1"></i> Vai trò</label>
                                <select class="form-control" id="filterRole">
                                    <option value="">Tất cả vai trò</option>
                                    <option value="1">🔴 Admin</option>
                                    <option value="2">🔵 Chủ trọ</option>
                                    <option value="3">⚫ Người thuê</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6 mb-3 mb-md-0">
                            <div class="form-group">
                                <label><i class="fa fa-toggle-on mr-1"></i> Trạng thái</label>
                                <select class="form-control" id="filterStatus">
                                    <option value="">Tất cả trạng thái</option>
                                    <option value="active">✅ Đang hoạt động</option>
                                    <option value="locked">🔒 Đã khóa</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-8 mb-3 mb-md-0">
                            <div class="form-group">
                                <label><i class="fa fa-search mr-1"></i> Tìm kiếm</label>
                                <input type="text" class="form-control" id="searchInput" placeholder="Tìm theo tên, email, SĐT...">
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-4 d-flex align-items-end">
                            <button class="btn btn-primary btn-block" type="button" id="btnSearch">
                                <i class="fa fa-search mr-1"></i> Tìm kiếm
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Data Table -->
                <div class="table-responsive">
                    <table id="usersTable" class="display table table-striped table-hover">
                        <thead>
                            <tr>
                                <th style="width: 50px;">Avatar</th>
                                <th>Thông tin</th>
                                <th>Điện thoại</th>
                                <th style="width: 100px;">Vai trò</th>
                                <th>Hoạt động</th>
                                <th style="width: 100px;">Trạng thái</th>
                                <th style="width: 140px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Thêm người dùng mới -->
<div class="modal fade" id="addUserModal" tabindex="-1" role="dialog" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header modal-header-primary">
                <h5 class="modal-title" id="addUserModalLabel">
                    <i class="fa fa-user-plus mr-2"></i> Thêm người dùng mới
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="addUserForm">
                    <!-- Chọn vai trò -->
                    <div class="form-group">
                        <label class="font-weight-bold">Chọn vai trò <span class="text-danger">*</span></label>
                        <div class="role-select-group">
                            <div class="role-option" data-role="3" onclick="selectRole(3)">
                                <i class="fa fa-user"></i>
                                <span>Người thuê</span>
                                <small>Tìm kiếm phòng trọ</small>
                            </div>
                            <div class="role-option" data-role="2" onclick="selectRole(2)">
                                <i class="fa fa-home"></i>
                                <span>Chủ trọ</span>
                                <small>Đăng phòng cho thuê</small>
                            </div>
                            <div class="role-option" data-role="1" onclick="selectRole(1)">
                                <i class="fa fa-user-shield"></i>
                                <span>Admin</span>
                                <small>Quản trị hệ thống</small>
                            </div>
                        </div>
                        <input type="hidden" id="addVaiTroId" name="VaiTroId" value="3" required>
                    </div>

                    <!-- Họ tên -->
                    <div class="form-group">
                        <label for="addHoTen">Họ và tên</label>
                        <input type="text" class="form-control" id="addHoTen" name="HoTen" placeholder="Nhập họ và tên">
                    </div>

                    <!-- Email -->
                    <div class="form-group">
                        <label for="addEmail">Email <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" id="addEmail" name="Email" placeholder="example@email.com" required>
                        <div class="field-error" id="emailError"></div>
                    </div>

                    <!-- Số điện thoại -->
                    <div class="form-group">
                        <label for="addDienThoai">Số điện thoại</label>
                        <input type="tel" class="form-control" id="addDienThoai" name="DienThoai" placeholder="0912345678">
                    </div>

                    <!-- Mật khẩu -->
                    <div class="form-group">
                        <label for="addPassword">Mật khẩu <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="addPassword" name="Password" placeholder="Tối thiểu 6 ký tự" required minlength="6">
                            <div class="input-group-append">
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('addPassword')">
                                    <i class="fa fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="field-error" id="passwordError"></div>
                    </div>

                    <!-- Xác nhận mật khẩu -->
                    <div class="form-group">
                        <label for="addConfirmPassword">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" id="addConfirmPassword" placeholder="Nhập lại mật khẩu" required>
                        <div class="field-error" id="confirmPasswordError"></div>
                    </div>

                    <!-- Email đã xác thực -->
                    <div class="form-group">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="addIsEmailXacThuc" name="IsEmailXacThuc">
                            <label class="custom-control-label" for="addIsEmailXacThuc">
                                Email đã xác thực (bỏ qua xác thực email)
                            </label>
                        </div>
                    </div>

                    <!-- Thông tin bổ sung cho Chủ trọ -->
                    <div id="landlordExtraInfo" style="display: none;">
                        <div class="alert alert-info">
                            <i class="fa fa-info-circle mr-2"></i>
                            <strong>Lưu ý:</strong> Chủ trọ cần được xác minh giấy tờ trước khi đăng phòng.
                        </div>
                    </div>

                    <!-- Thông tin bổ sung cho Admin -->
                    <div id="adminExtraInfo" style="display: none;">
                        <div class="alert alert-warning">
                            <i class="fa fa-exclamation-triangle mr-2"></i>
                            <strong>Cảnh báo:</strong> Admin có toàn quyền truy cập hệ thống. Hãy cân nhắc kỹ!
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    <i class="fa fa-times mr-1"></i> Hủy
                </button>
                <button type="button" class="btn btn-primary" id="btnSubmitAddUser" onclick="submitAddUser()">
                    <i class="fa fa-check mr-1"></i> Tạo người dùng
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Chi tiết người dùng -->
<div class="modal fade" id="userDetailModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header modal-header-primary">
                <h5 class="modal-title">
                    <i class="fa fa-user-circle mr-2"></i> Chi tiết người dùng
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Loading State -->
                <div id="userDetailLoading" class="loading-overlay">
                    <div class="spinner-border text-primary" role="status">
                        <span class="sr-only">Đang tải...</span>
                    </div>
                    <p>Đang tải thông tin...</p>
                </div>

                <!-- User Detail Content -->
                <div id="userDetailContent" style="display: none;">
                    <div class="row">
                        <!-- Left: Avatar & Basic Info -->
                        <div class="col-md-4">
                            <div class="text-center mb-4">
                                <img id="detailAvatar" src="/Content/img/default-avatar.png"
                                     alt="Avatar" class="avatar-lg mb-3">
                                <h5 id="detailHoTen" class="mb-1 font-weight-bold">-</h5>
                                <div id="detailVaiTro" class="mb-2">-</div>
                                <div id="detailTrangThai"></div>
                            </div>
                            <hr>
                            <ul class="info-list">
                                <li>
                                    <i class="fa fa-envelope"></i>
                                    <span id="detailEmail">-</span>
                                </li>
                                <li>
                                    <i class="fa fa-phone"></i>
                                    <span id="detailDienThoai">-</span>
                                </li>
                                <li>
                                    <i class="fa fa-id-card"></i>
                                    <span id="detailCCCD">-</span>
                                </li>
                                <li>
                                    <i class="fa fa-calendar"></i>
                                    <span id="detailNgayDangKy">-</span>
                                </li>
                            </ul>
                        </div>

                        <!-- Right: Detailed Info -->
                        <div class="col-md-8">
                            <ul class="nav nav-pills nav-secondary" id="pills-tab" role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link active" id="pills-overview-tab" data-toggle="pill" href="#pills-overview">
                                        <i class="fa fa-info-circle mr-1"></i> Tổng quan
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" id="pills-activity-tab" data-toggle="pill" href="#pills-activity">
                                        <i class="fa fa-chart-line mr-1"></i> Hoạt động
                                    </a>
                                </li>
                            </ul>
                            <div class="tab-content mt-3" id="pills-tabContent">
                                <!-- Overview Tab -->
                                <div class="tab-pane fade show active" id="pills-overview">
                                    <div class="user-detail-card">
                                        <div class="row mb-3">
                                            <div class="col-6">
                                                <div class="stat-box">
                                                    <h4 id="detailSoPhong" class="text-primary">0</h4>
                                                    <small>Số phòng đăng</small>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="stat-box">
                                                    <h4 id="detailSoDatPhong" class="text-success">0</h4>
                                                    <small>Số đặt phòng</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-4">
                                        <h6 class="font-weight-bold"><i class="fa fa-sticky-note mr-2"></i> Ghi chú</h6>
                                        <p id="detailGhiChu" class="text-muted">-</p>
                                    </div>
                                </div>

                                <!-- Activity Tab -->
                                <div class="tab-pane fade" id="pills-activity">
                                    <div class="empty-state">
                                        <i class="fa fa-history"></i>
                                        <h5>Chức năng đang phát triển</h5>
                                        <p>Lịch sử hoạt động sẽ được hiển thị ở đây</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    <i class="fa fa-times mr-1"></i> Đóng
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/pages/users.js?v=@DateTime.Now.Ticks"></script>
    <script>
        $(document).ready(function() {
            // Initialize Users page with configuration
            initUsersPage({
                urls: {
                    getUsers: '@Url.Action("GetUsers", "Users")',
                    getUserDetail: '@Url.Action("GetUserDetail", "Users")',
                    createUser: '@Url.Action("CreateUser", "Users")',
                    lockUser: '@Url.Action("LockUser", "Users")',
                    unlockUser: '@Url.Action("UnlockUser", "Users")'
                }
            });
        });
    </script>
}