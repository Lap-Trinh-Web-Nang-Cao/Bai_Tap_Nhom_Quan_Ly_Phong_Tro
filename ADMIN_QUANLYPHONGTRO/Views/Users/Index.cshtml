@model IEnumerable<ADMIN_QUANLYPHONGTRO.Models.ViewModels.UserItemViewModel>

@{
    ViewBag.Title = "Quản lý người dùng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Page Header -->
<div class="page-header">
    <h4 class="page-title">Quản lý người dùng</h4>
    <ul class="breadcrumbs">
        <li class="nav-home">
            <a href="@Url.Action("Index", "Dashboard")">
                <i class="flaticon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="flaticon-right-arrow"></i>
        </li>
        <li class="nav-item">
            <a href="#">Người dùng</a>
        </li>
        <li class="separator">
            <i class="flaticon-right-arrow"></i>
        </li>
        <li class="nav-item">
            <a href="#">Danh sách</a>
        </li>
    </ul>
</div>

<!-- Main Content Card -->
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center">
                    <h4 class="card-title">Danh sách người dùng</h4>
                    <button class="btn btn-primary btn-round ml-auto" data-toggle="modal" data-target="#addUserModal">
                        <i class="fa fa-plus"></i>
                        Thêm người dùng
                    </button>
                </div>
            </div>
            <div class="card-body">
                <!-- Filter & Search Section -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Vai trò</label>
                            <select class="form-control form-control-sm" id="filterRole">
                                <option value="">Tất cả</option>
                                <option value="1">Admin</option>
                                <option value="2">Chủ trọ</option>
                                <option value="3">Người thuê</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Trạng thái</label>
                            <select class="form-control form-control-sm" id="filterStatus">
                                <option value="">Tất cả</option>
                                <option value="active">Đang hoạt động</option>
                                <option value="locked">Đã khóa</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Tìm kiếm</label>
                            <div class="input-group">
                                <input type="text" class="form-control form-control-sm" id="searchInput" placeholder="Tìm theo tên, email, SĐT...">
                                <div class="input-group-append">
                                    <button class="btn btn-primary btn-sm" type="button" id="btnSearch">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Data Table -->
                <div class="table-responsive">
                    <table id="usersTable" class="display table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Avatar</th>
                                <th>Họ tên</th>
                                <th>Email</th>
                                <th>Điện thoại</th>
                                <th>Vai trò</th>
                                <th>Hoạt động</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Chi tiết người dùng -->
<div class="modal fade" id="userDetailModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title">
                    <span class="fw-mediumbold">Chi tiết người dùng</span>
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Loading State -->
                <div id="userDetailLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="sr-only">Đang tải...</span>
                    </div>
                </div>

                <!-- User Detail Content -->
                <div id="userDetailContent" style="display: none;">
                    <div class="row">
                        <!-- Left: Avatar & Basic Info -->
                        <div class="col-md-4">
                            <div class="text-center mb-4">
                                <img id="detailAvatar" src="/Content/img/default-avatar.png"
                                     alt="Avatar" class="img-fluid rounded-circle mb-3"
                                     style="width: 150px; height: 150px; object-fit: cover;">
                                <h4 id="detailHoTen" class="mb-1">-</h4>
                                <p id="detailVaiTro" class="text-muted mb-2">-</p>
                                <div id="detailTrangThai"></div>
                            </div>
                            <hr>
                            <div class="text-left">
                                <p><strong><i class="fa fa-envelope"></i> Email:</strong><br> <span id="detailEmail">-</span></p>
                                <p><strong><i class="fa fa-phone"></i> Điện thoại:</strong><br> <span id="detailDienThoai">-</span></p>
                                <p><strong><i class="fa fa-id-card"></i> CCCD:</strong><br> <span id="detailCCCD">-</span></p>
                                <p><strong><i class="fa fa-calendar"></i> Ngày đăng ký:</strong><br> <span id="detailNgayDangKy">-</span></p>
                            </div>
                        </div>

                        <!-- Right: Detailed Info -->
                        <div class="col-md-8">
                            <ul class="nav nav-pills nav-secondary nav-pills-no-bd" id="pills-tab" role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link active" id="pills-overview-tab" data-toggle="pill" href="#pills-overview">
                                        Tổng quan
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" id="pills-activity-tab" data-toggle="pill" href="#pills-activity">
                                        Hoạt động
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" id="pills-documents-tab" data-toggle="pill" href="#pills-documents">
                                        Giấy tờ
                                    </a>
                                </li>
                            </ul>
                            <div class="tab-content mt-3" id="pills-tabContent">
                                <!-- Overview Tab -->
                                <div class="tab-pane fade show active" id="pills-overview">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="card card-stats">
                                                <div class="card-body">
                                                    <div class="row">
                                                        <div class="col-6">
                                                            <div class="stats-icon purple">
                                                                <i class="fas fa-building"></i>
                                                            </div>
                                                            <h5 class="mb-0" id="detailSoPhong">0</h5>
                                                            <small class="text-muted">Số phòng</small>
                                                        </div>
                                                        <div class="col-6">
                                                            <div class="stats-icon green">
                                                                <i class="fas fa-star"></i>
                                                            </div>
                                                            <h5 class="mb-0" id="detailRating">4.5/5</h5>
                                                            <small class="text-muted">Đánh giá TB</small>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-3">
                                        <h6><i class="fa fa-map-marker-alt"></i> Địa chỉ thường trú</h6>
                                        <p id="detailDiaChi" class="text-muted">-</p>

                                        <h6><i class="fa fa-info-circle"></i> Ghi chú</h6>
                                        <p id="detailGhiChu" class="text-muted">-</p>
                                    </div>
                                </div>

                                <!-- Activity Tab -->
                                <div class="tab-pane fade" id="pills-activity">
                                    <div id="detailTimeline"></div>
                                </div>

                                <!-- Documents Tab -->
                                <div class="tab-pane fade" id="pills-documents">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <div class="card">
                                                <div class="card-body text-center">
                                                    <h6>CCCD Mặt trước</h6>
                                                    <img id="detailCCCDMatTruoc" src="/Content/img/no-image.png"
                                                         class="img-fluid rounded" style="max-height: 150px;">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <div class="card">
                                                <div class="card-body text-center">
                                                    <h6>CCCD Mặt sau</h6>
                                                    <img id="detailCCCDMatSau" src="/Content/img/no-image.png"
                                                         class="img-fluid rounded" style="max-height: 150px;">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
    var usersTable = null;

    $(document).ready(function() {
        // Initialize DataTable with server-side processing
        usersTable = $('#usersTable').DataTable({
            "processing": true,
            "serverSide": true,
            "pageLength": 10,
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "Tất cả"]],
            "ajax": {
                "url": "@Url.Action("GetUsers", "Users")",
                "type": "POST",
                "dataType": "json",
                "error": function(xhr, error, thrown) {
                    console.error('Lỗi tải dữ liệu:', error);
                }
            },
            "language": {
                "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/vi.json"
            },
            "order": [[1, "asc"]],
            "columnDefs": [
                { "orderable": false, "targets": [0, 7] },
                {
                    "targets": 0,
                    "data": "Avatar",
                    "render": function(data, type, row) {
                        var avatar = row.Avatar || '/Content/img/default-avatar.png';
                        return '<div class="avatar avatar-sm">' +
                            '<img src="' + avatar + '" alt="' + row.HoTen + '" class="avatar-img rounded-circle" ' +
                            'onerror="this.onerror=null; this.src=\'/Content/img/default-avatar.png\';" />' +
                            '</div>';
                    }
                },
                {
                    "targets": 1,
                    "data": "HoTen",
                    "render": function(data, type, row) {
                        return '<strong>' + (data || '-') + '</strong>';
                    }
                },
                {
                    "targets": 2,
                    "data": "Email",
                    "render": function(data, type, row) {
                        return data || '-';
                    }
                },
                {
                    "targets": 3,
                    "data": "DienThoai",
                    "render": function(data, type, row) {
                        return data || '-';
                    }
                },
                {
                    "targets": 4,
                    "data": "VaiTroId",
                    "render": function(data, type, row) {
                        var badgeClass = '';
                        var roleText = '';

                        if (row.VaiTroId == 1) {
                            badgeClass = 'badge-danger';
                            roleText = 'Admin';
                        } else if (row.VaiTroId == 2) {
                            badgeClass = 'badge-info';
                            roleText = 'Chủ trọ';
                        } else {
                            badgeClass = 'badge-primary';
                            roleText = 'Người thuê';
                        }

                        return '<span class="badge ' + badgeClass + '">' + roleText + '</span>';
                    }
                },
                {
                    "targets": 5,
                    "data": "SoPhongDaDang",
                    "render": function(data, type, row) {
                        var activity = '-';
                        if (row.VaiTroId == 2) {
                            activity = '<span><i class="fa fa-building"></i> ' + (row.SoPhongDaDang || 0) + ' phòng</span>';
                        } else if (row.VaiTroId == 3) {
                            activity = '<span><i class="fa fa-calendar"></i> ' + (row.SoPhongDaThue || 0) + ' đặt phòng</span>';
                        }
                        return '<small class="text-muted">' + activity + '</small>';
                    }
                },
                {
                    "targets": 6,
                    "data": "IsKhoa",
                    "render": function(data, type, row) {
                        var statusClass = row.IsKhoa ? 'badge-danger' : 'badge-success';
                        var statusText = row.IsKhoa ? 'Đã khóa' : 'Hoạt động';
                        return '<span class="badge ' + statusClass + '">' + statusText + '</span>';
                    }
                },
                {
                    "targets": 7,
                    "data": "NguoiDungId",
                    "render": function(data, type, row) {
                        var buttons = '<button type="button" class="btn btn-link btn-primary btn-lg" ' +
                            'data-toggle="tooltip" title="Xem chi tiết" ' +
                            'onclick="viewUserDetail(\'' + row.NguoiDungId + '\')">' +
                            '<i class="fa fa-eye"></i></button>';

                        if (!row.IsKhoa) {
                            buttons += '<button type="button" class="btn btn-link btn-danger" ' +
                                'data-toggle="tooltip" title="Khóa tài khoản" ' +
                                'onclick="lockUser(\'' + row.NguoiDungId + '\', \'' + (row.HoTen || 'Người dùng').replace(/'/g, "\\'") + '\')">' +
                                '<i class="fa fa-ban"></i></button>';
                        } else {
                            buttons += '<button type="button" class="btn btn-link btn-success" ' +
                                'data-toggle="tooltip" title="Mở khóa" ' +
                                'onclick="unlockUser(\'' + row.NguoiDungId + '\', \'' + (row.HoTen || 'Người dùng').replace(/'/g, "\\'") + '\')">' +
                                '<i class="fa fa-unlock"></i></button>';
                        }

                        return buttons;
                    }
                }
            ]
        });

        // Filter by Role
        $('#filterRole').on('change', function() {
            var val = $(this).val();
            if (val === "") {
                usersTable.columns(4).search('').draw();
            } else {
                var roleText = val == 1 ? 'Admin' : (val == 2 ? 'Chủ trọ' : 'Người thuê');
                usersTable.columns(4).search(roleText).draw();
            }
        });

        // Filter by Status
        $('#filterStatus').on('change', function() {
            var val = $(this).val();
            if (val === "") {
                usersTable.columns(6).search('').draw();
            } else {
                var statusText = val === 'active' ? 'Hoạt động' : 'Đã khóa';
                usersTable.columns(6).search(statusText).draw();
            }
        });

        // Search
        $('#btnSearch').on('click', function() {
            usersTable.search($('#searchInput').val()).draw();
        });

        $('#searchInput').on('keyup', function(e) {
            if (e.keyCode === 13) {
                $('#btnSearch').click();
            }
        });

        // Initialize Tooltips
        $('[data-toggle="tooltip"]').tooltip();
    });

    // View User Detail
    function viewUserDetail(userId) {
        $('#userDetailModal').modal('show');
        $('#userDetailLoading').show();
        $('#userDetailContent').hide();

        $.ajax({
            url: "@Url.Action("GetUserDetail", "Users")",
            type: 'GET',
            data: { id: userId },
            dataType: 'json',
            success: function(response) {
                if (response.success) {
                    var user = response.data;

                    // Fill data
                    $('#detailAvatar').attr('src', user.Avatar || '/Content/img/default-avatar.png');
                    $('#detailHoTen').text(user.HoTen || '-');
                    $('#detailEmail').text(user.Email || '-');
                    $('#detailDienThoai').text(user.DienThoai || '-');
                    $('#detailCCCD').text(user.SoCCCD || '-');
                    $('#detailNgayDangKy').text(user.NgayDangKy ? formatDate(new Date(user.NgayDangKy)) : '-');
                    $('#detailSoPhong').text(user.SoPhongDaDang || '0');
                    $('#detailDiaChi').text(user.DiaChi || '-');
                    $('#detailGhiChu').text(user.GhiChu || '-');

                    // Set role
                    var roleText = user.VaiTroId == 1 ? 'Admin' : (user.VaiTroId == 2 ? 'Chủ trọ' : 'Người thuê');
                    $('#detailVaiTro').text(roleText);

                    // Set status
                    var statusHtml = user.IsKhoa ?
                        '<span class="badge badge-danger">Đã khóa</span>' :
                        '<span class="badge badge-success">Hoạt động</span>';
                    $('#detailTrangThai').html(statusHtml);

                    // Set images
                    $('#detailCCCDMatTruoc').attr('src', user.CCCDMatTruoc || '/Content/img/no-image.png');
                    $('#detailCCCDMatSau').attr('src', user.CCCDMatSau || '/Content/img/no-image.png');

                    // Rating
                    $('#detailRating').text((user.Rating || 0) + '/5');

                    $('#userDetailLoading').hide();
                    $('#userDetailContent').show();
                } else {
                    showAlert('Lỗi', response.message || 'Không thể tải thông tin', 'error');
                }
            },
            error: function() {
                showAlert('Lỗi', 'Không thể tải thông tin người dùng', 'error');
            }
        });
    }

    // Lock User
    function lockUser(userId, userName) {
        swal({
            title: 'Xác nhận khóa tài khoản?',
            text: "Bạn có chắc muốn khóa tài khoản: " + userName + "?",
            icon: 'warning',
            buttons: {
                cancel: {
                    text: 'Hủy',
                    visible: true,
                    className: 'btn btn-secondary'
                },
                confirm: {
                    text: 'Khóa',
                    className: 'btn btn-danger'
                }
            }
        }).then((willLock) => {
            if (willLock) {
                $.ajax({
                    url: "@Url.Action("LockUser", "Users")",
                    type: 'POST',
                    data: { id: userId },
                    dataType: 'json',
                    success: function(response) {
                        if (response.success) {
                            swal("Thành công!", "Đã khóa tài khoản: " + userName, "success")
                                .then(() => {
                                    usersTable.ajax.reload();
                                });
                        } else {
                            showAlert('Lỗi', response.message || 'Không thể khóa', 'error');
                        }
                    },
                    error: function() {
                        showAlert('Lỗi', 'Lỗi server', 'error');
                    }
                });
            }
        });
    }

    // Unlock User
    function unlockUser(userId, userName) {
        swal({
            title: 'Xác nhận mở khóa?',
            text: "Bạn có chắc muốn mở khóa tài khoản: " + userName + "?",
            icon: 'info',
            buttons: {
                cancel: {
                    text: 'Hủy',
                    visible: true,
                    className: 'btn btn-secondary'
                },
                confirm: {
                    text: 'Mở khóa',
                    className: 'btn btn-success'
                }
            }
        }).then((willUnlock) => {
            if (willUnlock) {
                $.ajax({
                    url: "@Url.Action("UnlockUser", "Users")",
                    type: 'POST',
                    data: { id: userId },
                    dataType: 'json',
                    success: function(response) {
                        if (response.success) {
                            swal("Thành công!", "Đã mở khóa tài khoản: " + userName, "success")
                                .then(() => {
                                    usersTable.ajax.reload();
                                });
                        } else {
                            showAlert('Lỗi', response.message || 'Không thể mở khóa', 'error');
                        }
                    },
                    error: function() {
                        showAlert('Lỗi', 'Lỗi server', 'error');
                    }
                });
            }
        });
    }

    // Helper functions
    function formatDate(date) {
        if (!date) return '-';
        var d = new Date(date),
            month = '' + (d.getMonth() + 1),
            day = '' + d.getDate(),
            year = d.getFullYear();
        if (month.length < 2) month = '0' + month;
        if (day.length < 2) day = '0' + day;
        return [day, month, year].join('/');
    }

    function showAlert(title, message, icon) {
        swal(title, message, icon);
    }
    </script>
}