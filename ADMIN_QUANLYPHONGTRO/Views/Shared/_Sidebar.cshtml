@{
    ViewBag.Title = "_Sidebar";
}

<!-- Sidebar -->
<div class="sidebar sidebar-style-2">
    <div class="sidebar-wrapper scrollbar scrollbar-inner">
        <div class="sidebar-content">
            <!-- User Profile -->
            <div class="user">
                <div class="avatar-sm float-left mr-2">
                    <img src="~/Content/img/profile.jpg" alt="..." class="avatar-img rounded-circle">
                </div>
                <div class="info">
                    <a data-toggle="collapse" href="#collapseExample" aria-expanded="true">
                        <span>
                            @(Session["AdminName"] ?? "Administrator")
                            <span class="user-level">Admin</span>
                            <span class="caret"></span>
                        </span>
                    </a>
                    <div class="clearfix"></div>

                    <div class="collapse in" id="collapseExample">
                        <ul class="nav">
                            <li>
                                <a href="#profile">
                                    <span class="link-collapse">Hồ sơ cá nhân</span>
                                </a>
                            </li>
                            <li>
                                <a href="#edit">
                                    <span class="link-collapse">Chỉnh sửa</span>
                                </a>
                            </li>
                            <li>
                                <a href="#settings">
                                    <span class="link-collapse">Cài đặt</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            
            <!-- Menu Navigation -->
            <ul class="nav nav-primary">
                <!-- Dashboard -->
                <li class="nav-item active">
                    <a href="@Url.Action("Index", "Dashboard")">
                        <i class="fas fa-home"></i>
                        <p>Dashboard</p>
                    </a>
                </li>

                <li class="nav-section">
                    <span class="sidebar-mini-icon">
                        <i class="fa fa-ellipsis-h"></i>
                    </span>
                    <h4 class="text-section">QUẢN LÝ NGƯỜI DÙNG</h4>
                </li>

                <!-- Người dùng -->
                <li class="nav-item">
                    <a data-toggle="collapse" href="#users">
                        <i class="fas fa-users"></i>
                        <p>Quản lý người dùng</p>
                        <span class="caret"></span>
                    </a>
                    <div class="collapse" id="users">
                        <ul class="nav nav-collapse">
                            <li>
                                <a href="@Url.Action("Index", "Users", new { role = "nguoithue" })">
                                    <span class="sub-item">Người thuê</span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("Index", "Users", new { role = "chutro" })">
                                    <span class="sub-item">Chủ trọ</span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("Index", "Users", new { role = "admin" })">
                                    <span class="sub-item">Admin / Moderator</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <li class="nav-section">
                    <span class="sidebar-mini-icon">
                        <i class="fa fa-ellipsis-h"></i>
                    </span>
                    <h4 class="text-section">XÉT DUYỆT</h4>
                </li>

                <!-- Xét duyệt chủ trọ -->
                <li class="nav-item">
                    <a data-toggle="collapse" href="#hosts">
                        <i class="fas fa-user-check"></i>
                        <p>Xét duyệt chủ trọ</p>
                        <span class="caret"></span>
                    </a>
                    <div class="collapse" id="hosts">
                        <ul class="nav nav-collapse">
                            <li>
                                <a href="@Url.Action("Pending", "Hosts")">
                                    <span class="sub-item">Chờ duyệt</span>
                                    <span class="badge badge-warning">5</span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("Approved", "Hosts")">
                                    <span class="sub-item">Đã duyệt</span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("Rejected", "Hosts")">
                                    <span class="sub-item">Từ chối</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <!-- Xét duyệt phòng -->
                <li class="nav-item">
                    <a data-toggle="collapse" href="#rooms">
                        <i class="fas fa-building"></i>
                        <p>Xét duyệt phòng</p>
                        <span class="caret"></span>
                    </a>
                    <div class="collapse" id="rooms">
                        <ul class="nav nav-collapse">
                            <li>
                                <a href="@Url.Action("Pending", "Rooms")">
                                    <span class="sub-item">Chờ duyệt</span>
                                    <span class="badge badge-warning">8</span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("List", "Rooms")">
                                    <span class="sub-item">Tất cả phòng</span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("Locked", "Rooms")">
                                    <span class="sub-item">Phòng bị khóa</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <li class="nav-section">
                    <span class="sidebar-mini-icon">
                        <i class="fa fa-ellipsis-h"></i>
                    </span>
                    <h4 class="text-section">HỖ TRỢ & BÁO CÁO</h4>
                </li>

                <!-- Báo cáo vi phạm -->
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Reports")">
                        <i class="fas fa-exclamation-triangle"></i>
                        <p>Báo cáo vi phạm</p>
                        <span class="badge badge-danger">12</span>
                    </a>
                </li>

                <!-- Ticket hỗ trợ -->
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Support")">
                        <i class="fas fa-headset"></i>
                        <p>Ticket hỗ trợ</p>
                        <span class="badge badge-info">7</span>
                    </a>
                </li>

                <li class="nav-section">
                    <span class="sidebar-mini-icon">
                        <i class="fa fa-ellipsis-h"></i>
                    </span>
                    <h4 class="text-section">DANH MỤC & CẤU HÌNH</h4>
                </li>

                <!-- Danh mục hệ thống -->
                <li class="nav-item">
                    <a data-toggle="collapse" href="#categories">
                        <i class="fas fa-list"></i>
                        <p>Danh mục hệ thống</p>
                        <span class="caret"></span>
                    </a>
                    <div class="collapse" id="categories">
                        <ul class="nav nav-collapse">
                            <li>
                                <a href="@Url.Action("Utilities", "Settings")">
                                    <span class="sub-item">Tiện ích phòng</span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("Locations", "Settings")">
                                    <span class="sub-item">Quận / Phường</span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("SupportTypes", "Settings")">
                                    <span class="sub-item">Loại hỗ trợ</span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("ViolationTypes", "Settings")">
                                    <span class="sub-item">Loại vi phạm</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <!-- Biên lai - Thanh toán -->
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Transactions")">
                        <i class="fas fa-file-invoice-dollar"></i>
                        <p>Biên lai - Thanh toán</p>
                    </a>
                </li>

                <!-- Thống kê - Báo cáo -->
                <li class="nav-item">
                    <a data-toggle="collapse" href="#statistics">
                        <i class="fas fa-chart-line"></i>
                        <p>Thống kê - Báo cáo</p>
                        <span class="caret"></span>
                    </a>
                    <div class="collapse" id="statistics">
                        <ul class="nav nav-collapse">
                            <li>
                                <a href="@Url.Action("Revenue", "Statistics")">
                                    <span class="sub-item">Doanh thu</span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("Rooms", "Statistics")">
                                    <span class="sub-item">Phòng đăng</span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("Users", "Statistics")">
                                    <span class="sub-item">Người dùng</span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("Violations", "Statistics")">
                                    <span class="sub-item">Vi phạm</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <!-- Nhật ký hệ thống -->
                <li class="nav-item">
                    <a href="@Url.Action("AuditLog", "Settings")">
                        <i class="fas fa-history"></i>
                        <p>Nhật ký hệ thống</p>
                    </a>
                </li>

                <!-- Cài đặt hệ thống -->
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Settings")">
                        <i class="fas fa-cog"></i>
                        <p>Cài đặt hệ thống</p>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

