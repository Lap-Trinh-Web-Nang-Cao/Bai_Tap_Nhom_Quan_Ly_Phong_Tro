<!-- Custom Settings Template -->
<div class="custom-template">
    <div class="title">Cài đặt giao diện</div>
    <div class="custom-content">
        <div class="switcher">
            <!-- Logo Header Color -->
            <div class="switch-block">
                <h4>Màu Logo Header</h4>
                <div class="btnSwitch">
                    <button type="button" class="changeLogoHeaderColor" data-color="dark" title="Dark" aria-label="Set logo header color to dark"></button>
                    <button type="button" class="selected changeLogoHeaderColor" data-color="blue" title="Blue" aria-label="Set logo header color to blue"></button>
                    <button type="button" class="changeLogoHeaderColor" data-color="purple" title="Purple" aria-label="Set logo header color to purple"></button>
                    <button type="button" class="changeLogoHeaderColor" data-color="light-blue" title="Light Blue" aria-label="Set logo header color to light blue"></button>
                    <button type="button" class="changeLogoHeaderColor" data-color="green" title="Green" aria-label="Set logo header color to green"></button>
                    <button type="button" class="changeLogoHeaderColor" data-color="orange" title="Orange" aria-label="Set logo header color to orange"></button>
                    <button type="button" class="changeLogoHeaderColor" data-color="red" title="Red" aria-label="Set logo header color to red"></button>
                    <button type="button" class="changeLogoHeaderColor" data-color="white" title="White" aria-label="Set logo header color to white"></button>
                    <br />
                    <button type="button" class="changeLogoHeaderColor" data-color="dark2" title="Dark 2" aria-label="Set logo header color to dark 2"></button>
                    <button type="button" class="changeLogoHeaderColor" data-color="blue2" title="Blue 2" aria-label="Set logo header color to blue 2"></button>
                    <button type="button" class="changeLogoHeaderColor" data-color="purple2" title="Purple 2" aria-label="Set logo header color to purple 2"></button>
                    <button type="button" class="changeLogoHeaderColor" data-color="light-blue2" title="Light Blue 2" aria-label="Set logo header color to light blue 2"></button>
                    <button type="button" class="changeLogoHeaderColor" data-color="green2" title="Green 2" aria-label="Set logo header color to green 2"></button>
                    <button type="button" class="changeLogoHeaderColor" data-color="orange2" title="Orange 2" aria-label="Set logo header color to orange 2"></button>
                    <button type="button" class="changeLogoHeaderColor" data-color="red2" title="Red 2" aria-label="Set logo header color to red 2"></button>
                </div>
            </div>

            <!-- Navbar Header Color -->
            <div class="switch-block">
                <h4>Màu Navbar Header</h4>
                <div class="btnSwitch">
                    <button type="button" class="changeTopBarColor" data-color="dark" title="Dark" aria-label="Set navbar color to dark"></button>
                    <button type="button" class="changeTopBarColor" data-color="blue" title="Blue" aria-label="Set navbar color to blue"></button>
                    <button type="button" class="changeTopBarColor" data-color="purple" title="Purple" aria-label="Set navbar color to purple"></button>
                    <button type="button" class="changeTopBarColor" data-color="light-blue" title="Light Blue" aria-label="Set navbar color to light blue"></button>
                    <button type="button" class="changeTopBarColor" data-color="green" title="Green" aria-label="Set navbar color to green"></button>
                    <button type="button" class="changeTopBarColor" data-color="orange" title="Orange" aria-label="Set navbar color to orange"></button>
                    <button type="button" class="changeTopBarColor" data-color="red" title="Red" aria-label="Set navbar color to red"></button>
                    <button type="button" class="changeTopBarColor" data-color="white" title="White" aria-label="Set navbar color to white"></button>
                    <br />
                    <button type="button" class="changeTopBarColor" data-color="dark2" title="Dark 2" aria-label="Set navbar color to dark 2"></button>
                    <button type="button" class="selected changeTopBarColor" data-color="blue2" title="Blue 2" aria-label="Set navbar color to blue 2"></button>
                    <button type="button" class="changeTopBarColor" data-color="purple2" title="Purple 2" aria-label="Set navbar color to purple 2"></button>
                    <button type="button" class="changeTopBarColor" data-color="light-blue2" title="Light Blue 2" aria-label="Set navbar color to light blue 2"></button>
                    <button type="button" class="changeTopBarColor" data-color="green2" title="Green 2" aria-label="Set navbar color to green 2"></button>
                    <button type="button" class="changeTopBarColor" data-color="orange2" title="Orange 2" aria-label="Set navbar color to orange 2"></button>
                    <button type="button" class="changeTopBarColor" data-color="red2" title="Red 2" aria-label="Set navbar color to red 2"></button>
                </div>
            </div>

            <!-- Sidebar Color -->
            <div class="switch-block">
                <h4>Màu Sidebar</h4>
                <div class="btnSwitch">
                    <button type="button" class="selected changeSideBarColor" data-color="white" title="White" aria-label="Set sidebar color to white"></button>
                    <button type="button" class="changeSideBarColor" data-color="dark" title="Dark" aria-label="Set sidebar color to dark"></button>
                    <button type="button" class="changeSideBarColor" data-color="dark2" title="Dark 2" aria-label="Set sidebar color to dark 2"></button>
                </div>
            </div>

            <!-- Background Color -->
            <div class="switch-block">
                <h4>Màu nền</h4>
                <div class="btnSwitch">
                    <button type="button" class="changeBackgroundColor" data-color="bg2" title="Background 2" aria-label="Set background to gray"></button>
                    <button type="button" class="changeBackgroundColor selected" data-color="bg1" title="Background 1" aria-label="Set background to light"></button>
                    <button type="button" class="changeBackgroundColor" data-color="bg3" title="Background 3" aria-label="Set background to darker gray"></button>
                    <button type="button" class="changeBackgroundColor" data-color="dark" title="Dark" aria-label="Set background to dark"></button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toggle Button -->
    <div class="custom-toggle" title="Theme settings" aria-label="Open theme settings">
        <i class="fas fa-cog"></i>
    </div>
</div>
