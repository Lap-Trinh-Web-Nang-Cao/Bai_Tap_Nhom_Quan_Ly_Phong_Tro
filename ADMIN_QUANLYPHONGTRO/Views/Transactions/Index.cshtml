@model dynamic

@{
    ViewBag.Title = "Quản lý giao dịch";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Page Header -->
<div class="page-header">
    <h4 class="page-title">Quản lý giao dịch</h4>
    <ul class="breadcrumbs">
        <li class="nav-home">
            <a href="@Url.Action("Index", "Dashboard")">
                <i class="flaticon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="flaticon-right-arrow"></i>
        </li>
        <li class="nav-item">
            <a href="#">Giao dịch</a>
        </li>
    </ul>
</div>

<div class="row">
    <div class="col-md-12">
        <!-- Stats Cards -->
        <div class="row mb-3">
            <div class="col-md-3">
                <div class="card card-stats card-round">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-icon">
                                <div class="icon-big text-center icon-success bubble-shadow-small">
                                    <i class="fas fa-money-bill-wave"></i>
                                </div>
                            </div>
                            <div class="col col-stats ml-3 ml-sm-0">
                                <div class="numbers">
                                    <p class="card-category">Tổng doanh thu</p>
                                    <h4 class="card-title">125.5M</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-stats card-round">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-icon">
                                <div class="icon-big text-center icon-primary bubble-shadow-small">
                                    <i class="fas fa-receipt"></i>
                                </div>
                            </div>
                            <div class="col col-stats ml-3 ml-sm-0">
                                <div class="numbers">
                                    <p class="card-category">Giao dịch hôm nay</p>
                                    <h4 class="card-title">45</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-stats card-round">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-icon">
                                <div class="icon-big text-center icon-warning bubble-shadow-small">
                                    <i class="fas fa-clock"></i>
                                </div>
                            </div>
                            <div class="col col-stats ml-3 ml-sm-0">
                                <div class="numbers">
                                    <p class="card-category">Chờ xác nhận</p>
                                    <h4 class="card-title">12</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-stats card-round">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-icon">
                                <div class="icon-big text-center icon-info bubble-shadow-small">
                                    <i class="fas fa-check-double"></i>
                                </div>
                            </div>
                            <div class="col col-stats ml-3 ml-sm-0">
                                <div class="numbers">
                                    <p class="card-category">Đã xác nhận</p>
                                    <h4 class="card-title">1,234</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Card -->
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center">
                    <h4 class="card-title">Danh sách giao dịch</h4>
                    <div class="ml-auto">
                        <button class="btn btn-info btn-round mr-2" onclick="exportTransactions()">
                            <i class="fa fa-file-excel"></i>
                            Xuất Excel
                        </button>
                        <button class="btn btn-primary btn-round" onclick="refreshList()">
                            <i class="fa fa-sync-alt"></i>
                            Làm mới
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <!-- Filters -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="input-group">
                            <input type="text" class="form-control" id="searchInput" 
                                   placeholder="Mã giao dịch, tên người dùng...">
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="button">
                                    <i class="fa fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <select class="form-control" id="statusFilter">
                            <option value="">Tất cả trạng thái</option>
                            <option value="pending">Chờ xác nhận</option>
                            <option value="confirmed">Đã xác nhận</option>
                            <option value="cancelled">Đã hủy</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-control" id="amountFilter">
                            <option value="">Mức giá</option>
                            <option value="0-5">Dưới 5 triệu</option>
                            <option value="5-10">5-10 triệu</option>
                            <option value="10-20">10-20 triệu</option>
                            <option value="20+">Trên 20 triệu</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="date" class="form-control" id="dateFrom" placeholder="Từ ngày">
                    </div>
                    <div class="col-md-2">
                        <input type="date" class="form-control" id="dateTo" placeholder="Đến ngày">
                    </div>
                    <div class="col-md-1">
                        <button class="btn btn-info btn-block" onclick="applyFilters()">
                            <i class="fa fa-filter"></i>
                        </button>
                    </div>
                </div>

                <!-- Transactions Table -->
                <div class="table-responsive">
                    <table id="transactionsTable" class="table table-hover table-head-bg-success">
                        <thead>
                            <tr>
                                <th>Mã GD</th>
                                <th>Người thanh toán</th>
                                <th>Phòng</th>
                                <th>Số tiền</th>
                                <th>Ngày thanh toán</th>
                                <th>Minh chứng</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @* Mock data *@
                            @for (int i = 1; i <= 10; i++)
                            {
                                var isConfirmed = i % 3 != 0;
                                var amount = (new Random().Next(3, 20)) * 1000000;
                                var transCode = "TX" + DateTime.Now.Year + (100000 + i);
                                
                                <tr>
                                    <td>
                                        <strong class="text-primary">@transCode</strong>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar avatar-sm mr-2">
                                                <img src="@Url.Content("~/Content/img/profile.jpg")" alt="..." 
                                                     class="avatar-img rounded-circle">
                                            </div>
                                            <div>
                                                <div class="font-weight-bold">Nguyễn Văn @(char.ConvertFromUtf32(64 + i))</div>
                                                <small class="text-muted">09@(i)234567@(i)</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            <strong>Phòng @(100 + i)</strong>
                                        </div>
                                        <small class="text-muted">Nhà trọ ABC - Quận @(i % 5 + 1)</small>
                                    </td>
                                    <td>
                                        <div class="font-weight-bold text-success">
                                            @amount.ToString("N0") đ
                                        </div>
                                        <small class="text-muted">@(i % 2 == 0 ? "Tiền cọc" : "Tiền thuê T" + (i % 12 + 1))</small>
                                    </td>
                                    <td>
                                        <div>@DateTime.Now.AddDays(-i).ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted">@DateTime.Now.AddDays(-i).ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        @if (i % 2 == 0)
                                        {
                                            <button class="btn btn-sm btn-outline-primary" 
                                                    onclick="viewProof('@Url.Content("~/Content/img/profile.jpg")')">
                                                <i class="fas fa-image"></i> Xem
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted"><i>Chưa có</i></span>
                                        }
                                    </td>
                                    <td>
                                        @if (isConfirmed)
                                        {
                                            <span class="badge badge-success">
                                                <i class="fas fa-check-circle"></i> Đã xác nhận
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning">
                                                <i class="fas fa-clock"></i> Chờ xác nhận
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <button type="button" class="btn btn-sm btn-primary" 
                                                    onclick="viewTransactionDetails('trans-@i')" title="Xem chi tiết">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            @if (!isConfirmed)
                                            {
                                                <button type="button" class="btn btn-sm btn-success" 
                                                        onclick="confirmTransaction('trans-@i')" title="Xác nhận">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            }
                                            <button type="button" class="btn btn-sm btn-info" 
                                                    onclick="downloadReceipt('trans-@i')" title="Tải biên lai">
                                                <i class="fas fa-download"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <div class="text-muted">
                        Hiển thị 1-10 trong tổng số 1,246 giao dịch
                    </div>
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-success">
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1">&laquo;</a>
                            </li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">3</a></li>
                            <li class="page-item"><a class="page-link" href="#">...</a></li>
                            <li class="page-item"><a class="page-link" href="#">125</a></li>
                            <li class="page-item"><a class="page-link" href="#">&raquo;</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Transaction Detail Modal -->
<div class="modal fade" id="transactionDetailModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success">
                <h5 class="modal-title text-white">
                    <i class="fas fa-receipt"></i> Chi tiết giao dịch
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="font-weight-bold mb-3">Thông tin thanh toán</h6>
                                <table class="table table-borderless table-sm">
                                    <tr>
                                        <td class="text-muted">Mã giao dịch:</td>
                                        <td class="font-weight-bold">TX2024100001</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Số tiền:</td>
                                        <td class="font-weight-bold text-success">5,000,000 đ</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Loại:</td>
                                        <td>Tiền thuê tháng 12</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Ngày thanh toán:</td>
                                        <td>15/12/2024 14:30</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="font-weight-bold mb-3">Thông tin phòng</h6>
                                <table class="table table-borderless table-sm">
                                    <tr>
                                        <td class="text-muted">Phòng:</td>
                                        <td class="font-weight-bold">Phòng 101</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Nhà trọ:</td>
                                        <td>Nhà trọ ABC</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Địa chỉ:</td>
                                        <td>123 Đường XYZ, Quận 1</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Chủ trọ:</td>
                                        <td>Nguyễn Văn Chủ</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <h6 class="font-weight-bold mb-2">Minh chứng thanh toán</h6>
                        <div class="text-center p-3 border rounded">
                            <img src="@Url.Content("~/Content/img/profile.jpg")" alt="Proof" 
                                 style="max-width: 100%; max-height: 400px;">
                        </div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-12">
                        <h6 class="font-weight-bold mb-2">Ghi chú</h6>
                        <p class="text-muted">Đã chuyển khoản đầy đủ tiền thuê tháng 12/2024</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-info" onclick="downloadReceiptFromModal()">
                    <i class="fas fa-download"></i> Tải biên lai
                </button>
                <button type="button" class="btn btn-success" onclick="confirmTransactionFromModal()">
                    <i class="fas fa-check"></i> Xác nhận thanh toán
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Proof Image Modal -->
<div class="modal fade" id="proofModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Minh chứng thanh toán</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-center">
                <img id="proofImage" src="" alt="Proof" style="max-width: 100%; height: auto;">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    function applyFilters() {
        var status = $('#statusFilter').val();
        var amount = $('#amountFilter').val();
        var dateFrom = $('#dateFrom').val();
        var dateTo = $('#dateTo').val();
        var search = $('#searchInput').val();
        
        // TODO: Apply filters
        console.log('Applying filters:', { status, amount, dateFrom, dateTo, search });
    }

    function viewTransactionDetails(transId) {
        // TODO: Load transaction details from API
        $('#transactionDetailModal').modal('show');
    }

    function viewProof(imageUrl) {
        $('#proofImage').attr('src', imageUrl);
        $('#proofModal').modal('show');
    }

    function confirmTransaction(transId) {
        swal({
            title: 'Xác nhận thanh toán?',
            text: "Bạn có chắc chắn đã xác minh thông tin thanh toán?",
            icon: 'warning',
            buttons: {
                cancel: {
                    visible: true,
                    text: 'Hủy',
                    className: 'btn btn-secondary'
                },
                confirm: {
                    text: 'Xác nhận',
                    className: 'btn btn-success'
                }
            }
        }).then((willConfirm) => {
            if (willConfirm) {
                // TODO: Call API
                // @Url.Action("Confirm", "Transactions", new { id = transId })
                swal('Thành công!', 'Đã xác nhận thanh toán', 'success').then(() => {
                    location.reload();
                });
            }
        });
    }

    function confirmTransactionFromModal() {
        $('#transactionDetailModal').modal('hide');
        confirmTransaction('current-trans-id');
    }

    function downloadReceipt(transId) {
        swal('Đang tải...', 'Vui lòng đợi', 'info');
        // TODO: Implement download
        setTimeout(() => {
            swal('Thành công!', 'Đã tải biên lai', 'success');
        }, 1000);
    }

    function downloadReceiptFromModal() {
        downloadReceipt('current-trans-id');
    }

    function exportTransactions() {
        swal('Đang xuất...', 'Vui lòng đợi', 'info');
        // TODO: Implement export
        setTimeout(() => {
            swal('Thành công!', 'Đã xuất file Excel', 'success');
        }, 1000);
    }

    function refreshList() {
        location.reload();
    }
</script>
}

